import FondHtn.TOHard2.Chain
/-!
# Committed digit types: automata, runs and the left recursion

The policy commits the digit types of a chain *before* nature challenges a digit: the types are
generated by a left-recursive nonterminal `Λ_σ → [Λ_σ', block a] | [y, block a]`, which must be
expanded completely before its body `y` (the claim that sets the challenged digit) runs
(`FOND.TOHard2.lgh_lam`, `FOND.TOHard2.LG.lam`).  The nonterminals follow an automaton
`FOND.TOHard2.Aut` over atomic digit types; the generated sequences are its runs
(`FOND.TOHard2.Run`, built from the right, as the recursion builds them).

The *components* `FOND.TOHard2.Comp` are the automata of the construction:

| component | relation of the numbers (inner `z`, outer `o`) |
| --- | --- |
| `inc rg` | `o = z + 1` (no overflow) |
| `dec rg` | `o + 1 = z` |
| `cpy` | `o = z` |
| `cmp k ge` | `o = z` and `K ≤ z` (`ge`) resp. `z < K` (`¬ ge`), `K` the constant `k` |
| `bits` | `o = z`, and `z` is the committed number |

Soundness and completeness of these relations: `run_inc`, `exists_run_inc`, … .
-/

set_option linter.unusedSimpArgs false

namespace FOND

namespace TOHard2

open HardMP

/-- An automaton over atomic digit types (single initial and accepting state). -/
structure Aut where
  trans : List (ℕ × AT × ℕ)
  init : ℕ
  acc : ℕ

/-- **The runs** ending in state `σ`, built from the right. -/
inductive Run (A : Aut) : List AT → ℕ → Prop
  | one {a : AT} {σ : ℕ} (h : (A.init, a, σ) ∈ A.trans) : Run A [a] σ
  | snoc {as : List AT} {a : AT} {σ' σ : ℕ} (h : Run A as σ') (ht : (σ', a, σ) ∈ A.trans) :
      Run A (as ++ [a]) σ

/-- The components. -/
inductive Comp
  | inc (rg : Bool)
  | dec (rg : Bool)
  | cpy
  | cmp (k : ℕ) (ge : Bool)
  | bits
  deriving DecidableEq

namespace Comp

/-- The automaton of a component. -/
def aut : Comp → Aut
  | inc rg => ⟨[(0, .f10 rg, 0), (0, .f01 rg, 1), (1, .id, 1)], 0, 1⟩
  | dec rg => ⟨[(0, .f01 rg, 0), (0, .f10 rg, 1), (1, .id, 1)], 0, 1⟩
  | cpy => ⟨[(0, .id, 0)], 0, 0⟩
  | cmp k ge => ⟨[(0, .ce k, 0), (1, .ce k, 1), (0, .cw k, 1), (1, .cw k, 1), (0, .cv k, 0),
      (1, .cv k, 0)], 1, ge.toNat⟩
  | bits => ⟨[(0, .bit false, 0), (0, .bit true, 0)], 0, 0⟩

/-- The code of a component (in names). -/
def code : Comp → ℕ
  | inc rg => rg.toNat
  | dec rg => 2 + rg.toNat
  | cpy => 4
  | bits => 5
  | cmp k ge => 6 + 2 * k + ge.toNat

/-- Decoding of component codes. -/
def ofCode (n : ℕ) : Comp :=
  if n = 0 then inc false else if n = 1 then inc true else if n = 2 then dec false
  else if n = 3 then dec true else if n = 4 then cpy else if n = 5 then bits
  else cmp ((n - 6) / 2) (decide ((n - 6) % 2 = 1))

theorem ofCode_code (A : Comp) : ofCode A.code = A := by
  cases A with
  | inc rg => cases rg <;> rfl
  | dec rg => cases rg <;> rfl
  | cpy => rfl
  | bits => rfl
  | cmp k ge =>
    simp only [code, ofCode]
    rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
      if_neg (by omega)]
    cases ge <;> simp <;> omega

theorem code_inj {A B : Comp} (h : A.code = B.code) : A = B := by
  rw [← ofCode_code A, h, ofCode_code]

end Comp

/-! ## Relations along a run -/

/-- The digit types `as` relate the inner digits `z` to the outer digits `o`. -/
def Rel (cs : List (List ℕ)) (as : List AT) (z o : ℕ → Bool) : Prop :=
  ∀ d < as.length, (as.getD d .id).rho cs d (z d) = some (o d)

theorem rel_snoc {cs : List (List ℕ)} {as : List AT} {a : AT} {z o : ℕ → Bool} :
    Rel cs (as ++ [a]) z o ↔ Rel cs as z o ∧ a.rho cs as.length (z as.length) = some (o as.length) := by
  constructor
  · intro h
    refine ⟨fun d hd => ?_, ?_⟩
    · have := h d (by simp; omega)
      rwa [List.getD_append _ _ _ _ hd] at this
    · have := h as.length (by simp)
      rwa [List.getD_append_right _ _ _ _ le_rfl, Nat.sub_self, List.getD_cons_zero] at this
  · rintro ⟨h1, h2⟩ d hd
    simp only [List.length_append, List.length_cons, List.length_nil] at hd
    rcases Nat.lt_or_ge d as.length with hd' | hd'
    · rw [List.getD_append _ _ _ _ hd']; exact h1 d hd'
    · obtain rfl : d = as.length := by omega
      rw [List.getD_append_right _ _ _ _ le_rfl, Nat.sub_self, List.getD_cons_zero]; exact h2

theorem rel_one {cs : List (List ℕ)} {a : AT} {z o : ℕ → Bool} :
    Rel cs [a] z o ↔ a.rho cs 0 (z 0) = some (o 0) := by
  have := rel_snoc (cs := cs) (as := []) (a := a) (z := z) (o := o)
  simp only [List.nil_append, List.length_nil] at this
  rw [this]; simp [Rel]

theorem Run.length_pos {A : Aut} {as : List AT} {σ : ℕ} (h : Run A as σ) : 0 < as.length := by
  cases h <;> simp

/-- Runs by induction on the length (helper for the component lemmas). -/
theorem Run.rec_len {A : Aut} {P : List AT → ℕ → Prop}
    (h1 : ∀ a σ, (A.init, a, σ) ∈ A.trans → P [a] σ)
    (h2 : ∀ as a σ' σ, Run A as σ' → P as σ' → (σ', a, σ) ∈ A.trans → P (as ++ [a]) σ) :
    ∀ {as σ}, Run A as σ → P as σ := by
  intro as σ h
  induction h with
  | one h => exact h1 _ _ h
  | snoc h ht ih => exact h2 _ _ _ _ h ih ht

/-! ### The relations of the atomic types -/

section Rho

variable {cs : List (List ℕ)} {d : ℕ} {z v : Bool}

@[simp] theorem rho_id : AT.id.rho cs d z = some v ↔ v = z := by simp [AT.rho, eq_comm]
@[simp] theorem rho_f01 {rg : Bool} : (AT.f01 rg).rho cs d z = some v ↔ z = false ∧ v = true := by
  cases z <;> cases v <;> simp [AT.rho]
@[simp] theorem rho_f10 {rg : Bool} : (AT.f10 rg).rho cs d z = some v ↔ z = true ∧ v = false := by
  cases z <;> cases v <;> simp [AT.rho]
@[simp] theorem rho_bit {β : Bool} : (AT.bit β).rho cs d z = some v ↔ z = β ∧ v = z := by
  cases z <;> cases v <;> cases β <;> simp [AT.rho]
@[simp] theorem rho_ce {k : ℕ} : (AT.ce k).rho cs d z = some v ↔ z = decide (d ∈ cs.getI k) ∧ v = z := by
  simp only [AT.rho]; split_ifs with h <;> simp [h, eq_comm]
@[simp] theorem rho_cw {k : ℕ} : (AT.cw k).rho cs d z = some v ↔ (z = true ∧ d ∉ cs.getI k) ∧ v = z := by
  simp only [AT.rho]; split_ifs with h <;> simp [h, eq_comm] <;> tauto
@[simp] theorem rho_cv {k : ℕ} : (AT.cv k).rho cs d z = some v ↔ (z = false ∧ d ∈ cs.getI k) ∧ v = z := by
  simp only [AT.rho]; split_ifs with h <;> simp [h, eq_comm] <;> tauto

end Rho

/-! ### Increment and decrement -/

section Arith

variable {cs : List (List ℕ)}

theorem run_inc {rg : Bool} {as : List AT} {σ : ℕ} (h : Run (Comp.inc rg).aut as σ) :
    ∀ {z o : ℕ → Bool}, Rel cs as z o →
      (σ = 0 ∨ σ = 1) ∧ ofB o as.length + (if σ = 0 then 2 ^ as.length else 0) = ofB z as.length + 1 := by
  induction h with
  | one ht =>
    intro z o hr
    rw [rel_one] at hr
    simp only [Comp.aut, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at ht
    rcases ht with ⟨-, rfl, rfl⟩ | ⟨-, rfl, rfl⟩ | ⟨h, -⟩
    · obtain ⟨h1, h2⟩ := rho_f10.1 hr; simp [ofB_succ, h1, h2]
    · obtain ⟨h1, h2⟩ := rho_f01.1 hr; simp [ofB_succ, h1, h2]
    · simp at h
  | @snoc as a σ' σ h ht ih =>
    intro z o hr
    rw [rel_snoc] at hr
    obtain ⟨hs, ih⟩ := ih hr.1
    have h2 := hr.2
    simp only [Comp.aut, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at ht
    simp only [List.length_append, List.length_cons, List.length_nil, ofB_succ, pow_succ]
    rcases ht with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨h1, h3⟩ := rho_f10.1 h2
      simp only [eq_self_iff_true, if_true] at ih ⊢; simp [h1, h3]; omega
    · obtain ⟨h1, h3⟩ := rho_f01.1 h2
      simp only [eq_self_iff_true, if_true, one_ne_zero, if_false] at ih ⊢; simp [h1, h3]; omega
    · rw [rho_id] at h2
      simp only [one_ne_zero, if_false] at ih ⊢; rw [h2]; simp only [false_or, true_and]; omega

theorem run_dec {rg : Bool} {as : List AT} {σ : ℕ} (h : Run (Comp.dec rg).aut as σ) :
    ∀ {z o : ℕ → Bool}, Rel cs as z o →
      (σ = 0 ∨ σ = 1) ∧ ofB z as.length + (if σ = 0 then 2 ^ as.length else 0) = ofB o as.length + 1 := by
  induction h with
  | one ht =>
    intro z o hr
    rw [rel_one] at hr
    simp only [Comp.aut, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at ht
    rcases ht with ⟨-, rfl, rfl⟩ | ⟨-, rfl, rfl⟩ | ⟨h, -⟩
    · obtain ⟨h1, h2⟩ := rho_f01.1 hr; simp [ofB_succ, h1, h2]
    · obtain ⟨h1, h2⟩ := rho_f10.1 hr; simp [ofB_succ, h1, h2]
    · simp at h
  | @snoc as a σ' σ h ht ih =>
    intro z o hr
    rw [rel_snoc] at hr
    obtain ⟨hs, ih⟩ := ih hr.1
    have h2 := hr.2
    simp only [Comp.aut, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at ht
    simp only [List.length_append, List.length_cons, List.length_nil, ofB_succ, pow_succ]
    rcases ht with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨h1, h3⟩ := rho_f01.1 h2
      simp only [eq_self_iff_true, if_true] at ih ⊢; simp [h1, h3]; omega
    · obtain ⟨h1, h3⟩ := rho_f10.1 h2
      simp only [eq_self_iff_true, if_true, one_ne_zero, if_false] at ih ⊢; simp [h1, h3]; omega
    · rw [rho_id] at h2
      simp only [one_ne_zero, if_false] at ih ⊢; rw [h2]; simp only [false_or, true_and]; omega

theorem List.getD_mem' {α : Type} {l : List α} {d : ℕ} {x : α} (h : d < l.length) : l.getD d x ∈ l := by
  rw [List.getD_eq_getElem _ _ h]; exact List.getElem_mem h

theorem run_cpy_mem {as : List AT} {σ : ℕ} (h : Run Comp.cpy.aut as σ) : ∀ a ∈ as, a = .id := by
  induction h with
  | one ht =>
    intro a ha
    simp [Comp.aut] at ht; simp at ha; rw [ha]; exact ht.1
  | snoc h ht ih =>
    intro a ha
    simp [Comp.aut] at ht
    rcases List.mem_append.1 ha with ha | ha
    · exact ih a ha
    · simp at ha; rw [ha]; exact ht.2.1

theorem run_cpy {as : List AT} {σ : ℕ} (h : Run Comp.cpy.aut as σ) {z o : ℕ → Bool}
    (hr : Rel cs as z o) : ∀ d < as.length, o d = z d := by
  intro d hd
  have := hr d hd
  rw [run_cpy_mem h _ (List.getD_mem' hd), rho_id] at this
  exact this

/-- The digits of constant `k`. -/
def kDig (cs : List (List ℕ)) (k : ℕ) : ℕ → Bool := fun d => decide (d ∈ cs.getI k)

theorem run_cmp {k : ℕ} {ge : Bool} {as : List AT} {σ : ℕ} (h : Run (Comp.cmp k ge).aut as σ) :
    ∀ {z o : ℕ → Bool}, Rel cs as z o →
      (∀ d < as.length, o d = z d) ∧ (σ = 1 ↔ ofB (kDig cs k) as.length ≤ ofB z as.length) ∧
        (σ = 0 ∨ σ = 1) := by
  induction h with
  | one ht =>
    intro z o hr
    rw [rel_one] at hr
    simp only [Comp.aut, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at ht
    simp only [List.length_singleton, Nat.lt_one_iff, forall_eq]
    rcases ht with ⟨h0, rfl, rfl⟩ | ⟨-, rfl, rfl⟩ | ⟨h0, rfl, rfl⟩ | ⟨-, rfl, rfl⟩ | ⟨h0, rfl, rfl⟩ |
      ⟨-, rfl, rfl⟩
    · simp at h0
    · obtain ⟨h1, h2⟩ := rho_ce.1 hr; simp [ofB_succ, kDig, h1, h2]
    · simp at h0
    · obtain ⟨⟨h1, h1'⟩, h2⟩ := rho_cw.1 hr; simp [ofB_succ, kDig, h1, h1', h2]
    · simp at h0
    · obtain ⟨⟨h1, h1'⟩, h2⟩ := rho_cv.1 hr; simp [ofB_succ, kDig, h1, h1', h2]
  | @snoc as a σ' σ h ht ih =>
    intro z o hr
    rw [rel_snoc] at hr
    obtain ⟨hzo, hs, hσ'⟩ := ih hr.1
    have h2 := hr.2
    have hlt := ofB_lt z as.length
    have hltK := ofB_lt (kDig cs k) as.length
    simp only [Comp.aut, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at ht
    simp only [List.length_append, List.length_cons, List.length_nil]
    have hsplit : (∀ d < as.length + 1, o d = z d) ↔
        (∀ d < as.length, o d = z d) ∧ o as.length = z as.length :=
      ⟨fun h => ⟨fun d hd => h d (by omega), h _ (by omega)⟩, fun ⟨h1, h2⟩ d hd => by
        rcases Nat.lt_or_ge d as.length with h | h
        · exact h1 d h
        · obtain rfl : d = as.length := by omega
          exact h2⟩
    rw [hsplit, ofB_succ, ofB_succ]
    rcases ht with ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩ |
      ⟨rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl⟩
    · obtain ⟨h1, h3⟩ := rho_ce.1 h2
      refine ⟨⟨hzo, h3⟩, ?_, by simp⟩
      simp only [zero_ne_one, false_iff, not_le] at hs ⊢
      simp only [kDig] at hs ⊢; rw [← h1]; cases z as.length <;> simp <;> omega
    · obtain ⟨h1, h3⟩ := rho_ce.1 h2
      refine ⟨⟨hzo, h3⟩, ?_, by simp⟩
      simp only [true_iff] at hs ⊢
      simp only [kDig] at hs ⊢; rw [← h1]; cases z as.length <;> simp <;> omega
    · obtain ⟨⟨h1, h1'⟩, h3⟩ := rho_cw.1 h2
      refine ⟨⟨hzo, h3⟩, ?_, by simp⟩
      simp only [true_iff]
      simp [kDig, h1, h1']; omega
    · obtain ⟨⟨h1, h1'⟩, h3⟩ := rho_cw.1 h2
      refine ⟨⟨hzo, h3⟩, ?_, by simp⟩
      simp only [true_iff]
      simp [kDig, h1, h1']; omega
    · obtain ⟨⟨h1, h1'⟩, h3⟩ := rho_cv.1 h2
      refine ⟨⟨hzo, h3⟩, ?_, by simp⟩
      simp only [zero_ne_one, false_iff, not_le]
      simp [kDig, h1, h1']; omega
    · obtain ⟨⟨h1, h1'⟩, h3⟩ := rho_cv.1 h2
      refine ⟨⟨hzo, h3⟩, ?_, by simp⟩
      simp only [zero_ne_one, false_iff, not_le]
      simp [kDig, h1, h1']; omega

theorem run_bits_mem {as : List AT} {σ : ℕ} (h : Run Comp.bits.aut as σ) :
    ∀ a ∈ as, ∃ β, a = .bit β := by
  induction h with
  | one ht =>
    intro a ha
    simp [Comp.aut] at ht; simp at ha; subst ha
    rcases ht with ⟨h, -⟩ | ⟨h, -⟩ <;> exact ⟨_, h⟩
  | snoc h ht ih =>
    intro a ha
    simp [Comp.aut] at ht
    rcases List.mem_append.1 ha with ha | ha
    · exact ih a ha
    · simp at ha; subst ha
      rcases ht with ⟨-, h, -⟩ | ⟨-, h, -⟩ <;> exact ⟨_, h⟩

/-! ### Completeness: runs for given digits -/

theorem rel_congr {as : List AT} {z o o' : ℕ → Bool} (h : Rel cs as z o)
    (he : ∀ d < as.length, o d = o' d) : Rel cs as z o' := fun d hd => by rw [← he d hd]; exact h d hd

theorem rel_snoc_of {as : List AT} {a : AT} {z o : ℕ → Bool} {v : Bool} (h : Rel cs as z o)
    (ha : a.rho cs as.length (z as.length) = some v) :
    Rel cs (as ++ [a]) z (fun d => if d = as.length then v else o d) := by
  rw [rel_snoc]
  refine ⟨rel_congr h fun d hd => by simp [show d ≠ as.length by omega], by simpa using ha⟩

theorem exists_run_inc (rg : Bool) (z : ℕ → Bool) : ∀ n, 1 ≤ n → ∃ as σ, as.length = n ∧
    Run (Comp.inc rg).aut as σ ∧ (σ = 0 ↔ ∀ d < n, z d = true) ∧ ∃ o, Rel cs as z o := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base =>
    cases hz : z 0
    · refine ⟨[.f01 rg], 1, rfl, .one (by simp [Comp.aut]), ?_, fun _ => true, ?_⟩
      · simp only [one_ne_zero, false_iff, not_forall]; exact ⟨0, by simp [hz]⟩
      · rw [rel_one]; simp [hz]
    · refine ⟨[.f10 rg], 0, rfl, .one (by simp [Comp.aut]), ?_, fun _ => false, ?_⟩
      · simp only [true_iff]; intro d hd; obtain rfl : d = 0 := by omega
        exact hz
      · rw [rel_one]; simp [hz]
  | succ n hn ih =>
    obtain ⟨as, σ, hl, hrun, hσ, o, ho⟩ := ih
    have h01 := (run_inc hrun ho).1
    rcases h01 with rfl | rfl
    · cases hz : z n
      · refine ⟨as ++ [.f01 rg], 1, by simp [hl], .snoc hrun (by simp [Comp.aut]), ?_, _,
          rel_snoc_of ho (v := true) (by rw [hl]; simp [hz])⟩
        simp only [one_ne_zero, false_iff, not_forall]; exact ⟨n, by simp [hz]⟩
      · refine ⟨as ++ [.f10 rg], 0, by simp [hl], .snoc hrun (by simp [Comp.aut]), ?_, _,
          rel_snoc_of ho (v := false) (by rw [hl]; simp [hz])⟩
        simp only [true_iff]
        intro d hd
        rcases Nat.lt_or_ge d n with h | h
        · exact hσ.1 rfl d h
        · obtain rfl : d = n := by omega
          exact hz
    · refine ⟨as ++ [.id], 1, by simp [hl], .snoc hrun (by simp [Comp.aut]), ?_, _,
        rel_snoc_of ho (v := z n) (by rw [hl]; simp)⟩
      simp only [one_ne_zero, false_iff, not_forall]
      have : ¬ ∀ d < n, z d = true := fun h => absurd (hσ.2 h) one_ne_zero
      push_neg at this
      obtain ⟨d, hd, hzd⟩ := this
      exact ⟨d, by simp [show d < n + 1 by omega, hzd]⟩

/-- **Increment, completeness.** -/
theorem inc_complete (rg : Bool) {z : ℕ → Bool} {n : ℕ} (hn : 1 ≤ n) (h : ofB z n + 1 < 2 ^ n) :
    ∃ as, as.length = n ∧ Run (Comp.inc rg).aut as 1 ∧ ∃ o, Rel cs as z o ∧ ofB o n = ofB z n + 1 := by
  obtain ⟨as, σ, hl, hrun, hσ, o, ho⟩ := exists_run_inc (cs := cs) rg z n hn
  have hs := run_inc hrun ho
  rcases hs.1 with rfl | rfl
  · have := ofB_all_true (hσ.1 rfl); omega
  · refine ⟨as, hl, hrun, o, ho, ?_⟩
    have := hs.2; simp only [one_ne_zero, if_false, add_zero] at this; rwa [hl] at this

theorem exists_run_dec (rg : Bool) (z : ℕ → Bool) : ∀ n, 1 ≤ n → ∃ as σ, as.length = n ∧
    Run (Comp.dec rg).aut as σ ∧ (σ = 0 ↔ ∀ d < n, z d = false) ∧ ∃ o, Rel cs as z o := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base =>
    cases hz : z 0
    · refine ⟨[.f01 rg], 0, rfl, .one (by simp [Comp.aut]), ?_, fun _ => true, ?_⟩
      · simp only [true_iff]; intro d hd; obtain rfl : d = 0 := by omega
        exact hz
      · rw [rel_one]; simp [hz]
    · refine ⟨[.f10 rg], 1, rfl, .one (by simp [Comp.aut]), ?_, fun _ => false, ?_⟩
      · simp only [one_ne_zero, false_iff, not_forall]; exact ⟨0, by simp [hz]⟩
      · rw [rel_one]; simp [hz]
  | succ n hn ih =>
    obtain ⟨as, σ, hl, hrun, hσ, o, ho⟩ := ih
    have h01 := (run_dec hrun ho).1
    rcases h01 with rfl | rfl
    · cases hz : z n
      · refine ⟨as ++ [.f01 rg], 0, by simp [hl], .snoc hrun (by simp [Comp.aut]), ?_, _,
          rel_snoc_of ho (v := true) (by rw [hl]; simp [hz])⟩
        simp only [true_iff]
        intro d hd
        rcases Nat.lt_or_ge d n with h | h
        · exact hσ.1 rfl d h
        · obtain rfl : d = n := by omega
          exact hz
      · refine ⟨as ++ [.f10 rg], 1, by simp [hl], .snoc hrun (by simp [Comp.aut]), ?_, _,
          rel_snoc_of ho (v := false) (by rw [hl]; simp [hz])⟩
        simp only [one_ne_zero, false_iff, not_forall]; exact ⟨n, by simp [hz]⟩
    · refine ⟨as ++ [.id], 1, by simp [hl], .snoc hrun (by simp [Comp.aut]), ?_, _,
        rel_snoc_of ho (v := z n) (by rw [hl]; simp)⟩
      simp only [one_ne_zero, false_iff, not_forall]
      have : ¬ ∀ d < n, z d = false := fun h => absurd (hσ.2 h) one_ne_zero
      push_neg at this
      obtain ⟨d, hd, hzd⟩ := this
      exact ⟨d, by simp [show d < n + 1 by omega, hzd]⟩

/-- **Decrement, completeness.** -/
theorem dec_complete (rg : Bool) {z : ℕ → Bool} {n : ℕ} (hn : 1 ≤ n) (h : 1 ≤ ofB z n) :
    ∃ as, as.length = n ∧ Run (Comp.dec rg).aut as 1 ∧ ∃ o, Rel cs as z o ∧ ofB o n + 1 = ofB z n := by
  obtain ⟨as, σ, hl, hrun, hσ, o, ho⟩ := exists_run_dec (cs := cs) rg z n hn
  have hs := run_dec hrun ho
  rcases hs.1 with rfl | rfl
  · have : ofB z n = 0 := by rw [ofB_congr (g' := fun _ => false) (hσ.1 rfl), ofB_false]
    omega
  · refine ⟨as, hl, hrun, o, ho, ?_⟩
    have := hs.2; simp only [one_ne_zero, if_false, add_zero] at this; rw [hl] at this; omega

/-- **Copy, completeness.** -/
theorem cpy_complete (z : ℕ → Bool) : ∀ n, 1 ≤ n → ∃ as, as.length = n ∧ Run Comp.cpy.aut as 0 ∧
    Rel cs as z z := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => exact ⟨[.id], rfl, .one (by simp [Comp.aut]), by rw [rel_one]; simp⟩
  | succ n hn ih =>
    obtain ⟨as, hl, hrun, ho⟩ := ih
    refine ⟨as ++ [.id], by simp [hl], .snoc hrun (by simp [Comp.aut]), ?_⟩
    rw [rel_snoc]; exact ⟨ho, by simp⟩

theorem exists_run_cmp (k : ℕ) (ge : Bool) (z : ℕ → Bool) : ∀ n, 1 ≤ n → ∃ as σ, as.length = n ∧
    Run (Comp.cmp k ge).aut as σ ∧ Rel cs as z z := by
  have hty : ∀ d σ, σ = 0 ∨ σ = 1 → ∃ a σ', (σ, a, σ') ∈ (Comp.cmp k ge).aut.trans ∧
      a.rho cs d (z d) = some (z d) := by
    intro d σ hσ
    by_cases h1 : z d = decide (d ∈ cs.getI k)
    · exact ⟨.ce k, σ, by rcases hσ with rfl | rfl <;> simp [Comp.aut], by simp [h1]⟩
    · cases hz : z d
      · refine ⟨.cv k, 0, by rcases hσ with rfl | rfl <;> simp [Comp.aut], ?_⟩
        rw [rho_cv]; refine ⟨⟨rfl, ?_⟩, rfl⟩
        rw [hz] at h1; simpa using h1
      · refine ⟨.cw k, 1, by rcases hσ with rfl | rfl <;> simp [Comp.aut], ?_⟩
        rw [rho_cw]; refine ⟨⟨rfl, ?_⟩, rfl⟩
        rw [hz] at h1; simpa using h1
  intro n hn
  induction n, hn using Nat.le_induction with
  | base =>
    obtain ⟨a, σ', ht, ha⟩ := hty 0 1 (Or.inr rfl)
    exact ⟨[a], σ', rfl, .one ht, by rw [rel_one]; exact ha⟩
  | succ n hn ih =>
    obtain ⟨as, σ, hl, hrun, ho⟩ := ih
    obtain ⟨a, σ', ht, ha⟩ := hty n σ (run_cmp hrun ho).2.2
    refine ⟨as ++ [a], σ', by simp [hl], .snoc hrun ht, ?_⟩
    rw [rel_snoc]; exact ⟨ho, by rw [hl]; exact ha⟩

/-- **Comparison, completeness.** -/
theorem cmp_complete (k : ℕ) (ge : Bool) {z : ℕ → Bool} {n : ℕ} (hn : 1 ≤ n)
    (h : ge = decide (ofB (kDig cs k) n ≤ ofB z n)) :
    ∃ as, as.length = n ∧ Run (Comp.cmp k ge).aut as (Comp.cmp k ge).aut.acc ∧ Rel cs as z z := by
  obtain ⟨as, σ, hl, hrun, ho⟩ := exists_run_cmp (cs := cs) k ge z n hn
  obtain ⟨-, hσ, h01⟩ := run_cmp hrun ho
  refine ⟨as, hl, ?_, ho⟩
  convert hrun
  rw [hl] at hσ
  simp only [Comp.aut]
  subst h
  by_cases hle : ofB (kDig cs k) n ≤ ofB z n
  · simp [hle, hσ.2 hle]
  · simp only [hle, decide_false, Bool.toNat_false]
    rcases h01 with h0 | h0
    · exact h0.symm
    · exact absurd (hσ.1 h0) hle

theorem exists_run_bits (β : ℕ → Bool) : ∀ n, 1 ≤ n →
    Run Comp.bits.aut ((List.range n).map fun d => .bit (β d)) 0 := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => exact .one (by cases β 0 <;> simp [Comp.aut])
  | succ n hn ih =>
    rw [List.range_succ, List.map_append, List.map_singleton]
    exact .snoc ih (by cases β n <;> simp [Comp.aut])

end Arith

/-! ## The left recursion -/

section Lam

variable {G : Gram} {A : Aut} {lam : ℕ → ℕ} {y : ℕ} {blk : AT → List (ℕ × List ASpec)}

/-- **The left recursion**, soundness: the policy commits a run before the body executes. -/
theorem lgh_lam (hΛ : ∀ σ bs, (lam σ, bs) ∈ G.methL → ∃ σ' a, (σ', a, σ) ∈ A.trans ∧
      (bs = (true, lam σ') :: syms (blk a) ∨ (σ' = A.init ∧ bs = (true, y) :: syms (blk a)))) :
    ∀ {n : ℕ} {σ : ℕ} {xs : List (Bool × ℕ)} {c : Cfg} {Φ : Set Cfg},
    LGH G n ((true, lam σ) :: xs) c Φ →
      ∃ as, Run A as σ ∧ LGH G n ((true, y) :: syms (as.flatMap blk) ++ xs) c Φ := by
  intro n
  induction n with
  | zero => intro σ xs c Φ h; exact absurd h not_lgh_zero
  | succ n ih =>
    intro σ xs c Φ h
    obtain ⟨bs, hb, h⟩ := lgh_comp_iff.1 h
    obtain ⟨σ', a, ht, rfl | ⟨rfl, rfl⟩⟩ := hΛ σ bs hb
    · rw [List.cons_append] at h
      obtain ⟨as, hrun, h'⟩ := ih h
      refine ⟨as ++ [a], .snoc hrun ht, ?_⟩
      have := h'.mono (n' := n + 1) (by omega) le_rfl
      simpa [List.flatMap_append, List.append_assoc] using this
    · refine ⟨[a], .one ht, ?_⟩
      have := h.mono (n' := n + 1) (by omega) le_rfl
      simpa using this

/-- **The left recursion**, completeness. -/
theorem LG.ofLam (hΛ : ∀ σ bs, (∃ σ' a, (σ', a, σ) ∈ A.trans ∧
      (bs = (true, lam σ') :: syms (blk a) ∨ (σ' = A.init ∧ bs = (true, y) :: syms (blk a)))) →
      (lam σ, bs) ∈ G.methL) {as : List AT} {σ : ℕ} (hrun : Run A as σ) :
    ∀ {xs : List (Bool × ℕ)} {c : Cfg} {Φ : Set Cfg},
      LG G ((true, y) :: syms (as.flatMap blk) ++ xs) c Φ → LG G ((true, lam σ) :: xs) c Φ := by
  induction hrun with
  | one ht =>
    intro xs c Φ h
    exact LG.comp (hΛ _ _ ⟨_, _, ht, Or.inr ⟨rfl, rfl⟩⟩) (by simpa using h)
  | @snoc as a σ' σ hrun ht ih =>
    intro xs c Φ h
    refine LG.comp (hΛ _ _ ⟨_, _, ht, Or.inl rfl⟩) ?_
    rw [List.cons_append]
    exact ih (by simpa [List.flatMap_append, List.append_assoc] using h)

end Lam

