import HtnComplexity.Computable.BinDom
/-!
# Binarisation of a described totally ordered domain: correctness

`HtnComplexity/Computable/BinDom.lean` builds the binarised description `binDom d`,
`binInst q`.  This file proves that the compilation preserves and reflects solvability:

> `HTN.Syn.Binarise.solvable_bin_iff` —
> for a totally ordered domain description `d` and a *rooted* instance description `q`,
> `Solvable (binDom d) (binInst q) ↔ Solvable d q`.

Both sides are put in the normal form of `HTN.Problem.solvable_iff_yieldSeq`: solvability of a
totally ordered problem means that the initial task sequence is refined, leftmost first, into an
executable action sequence reaching the goal.  What has to be compared is therefore the
context-free languages generated by the two descriptions, and the two halves of that comparison
are

* `HTN.Syn.Binarise.exists_yieldSeq_binDom` — every refinement of the source is a refinement of
  the compiled description, up to the no-ops the chain inserts;
* `HTN.Syn.Binarise.yieldSeq_of_corr` — conversely, every refinement of the compiled
  description decodes to one of the source.  The induction runs over an auxiliary relation
  `HTN.Syn.Binarise.Corr`, which describes the intermediate task sequences of the compiled
  derivation: an encoded task, a no-op, or a *suspended* helper name `H(m,k)` standing for the
  suffix of the body of the method `m` from position `k` on.
-/

namespace HTN

namespace Syn

namespace Binarise

variable {d : DomDesc}

/-- The encoding of a task sequence of the source description. -/
def emb (xs : List (ℕ ⊕ ℕ)) : List (ℕ ⊕ ℕ) := xs.map encTask

@[simp] lemma emb_nil : emb [] = [] := rfl

@[simp] lemma emb_cons (x : ℕ ⊕ ℕ) (xs : List (ℕ ⊕ ℕ)) :
    emb (x :: xs) = encTask x :: emb xs := rfl

@[simp] lemma emb_append (xs ys : List (ℕ ⊕ ℕ)) : emb (xs ++ ys) = emb xs ++ emb ys :=
  List.map_append

/-- The compiled description refines a no-op task into the no-op action. -/
lemma yieldSeq_nopTask (d : DomDesc) : (binDom d).toDomain.YieldSeq [nopTask] [nopA] :=
  Domain.YieldSeq.prim Domain.YieldSeq.nil

/-! ### From the source to the compiled description -/

/-- **The chain of a method.**  A refinement of the suffix of the body of the method `m` from
position `k` on is, after one trailing no-op, a refinement of the `k`-th helper task of the
chain replacing `m`. -/
theorem yieldSeq_chain (d : DomDesc) {m : ℕ} (hm : m < d.methods.length) :
    ∀ j k, (d.bd m).length - k ≤ j → k < (d.bd m).length → ∀ ys,
      (binDom d).toDomain.YieldSeq (emb ((d.bd m).drop k)) ys →
      (binDom d).toDomain.YieldSeq [Sum.inr (headName d m k)] (ys ++ [nopA]) := by
  intro j
  induction j with
  | zero =>
    intro k h1 h2
    omega
  | succ j ih =>
    intro k h1 h2 ys hys
    have hdrop : (d.bd m).drop k = (d.bd m).getI k :: (d.bd m).drop (k + 1) := by
      rw [List.getI_eq_getElem (l := d.bd m) h2]
      exact List.drop_eq_getElem_cons h2
    rw [hdrop, emb_cons, show (encTask ((d.bd m).getI k) :: emb ((d.bd m).drop (k + 1))) =
      [encTask ((d.bd m).getI k)] ++ emb ((d.bd m).drop (k + 1)) from rfl] at hys
    obtain ⟨u, v, rfl, hu, hv⟩ := hys.split
    have hprod : (binDom d).toDomain.SeqBody (headName d m k)
        [encTask ((d.bd m).getI k), tailTask d m k] :=
      (seqBody_binDom_iff d).2 (Or.inr ⟨m, k, hm, h2, rfl, rfl⟩)
    by_cases hlast : k + 1 = (d.bd m).length
    · have htail : tailTask d m k = nopTask := by
        simp [tailTask, hlast]
      have hvnil : v = [] := by
        have : (d.bd m).drop (k + 1) = [] := List.drop_eq_nil_of_le (by omega)
        rw [this] at hv
        cases hv
        rfl
      subst hvnil
      refine Domain.YieldSeq.comp hprod ?_
      rw [List.append_nil, htail]
      have : (binDom d).toDomain.YieldSeq ([encTask ((d.bd m).getI k)] ++ [nopTask])
          (u ++ [nopA]) := hu.append (yieldSeq_nopTask d)
      simpa using this
    · have hk1 : k + 1 < (d.bd m).length := by omega
      have htail : tailTask d m k = Sum.inr (hName m (k + 1)) := by
        simp [tailTask, hlast]
      have hhead : headName d m (k + 1) = hName m (k + 1) := by
        simp [headName]
      have hrec := ih (k + 1) (by omega) hk1 v hv
      rw [hhead] at hrec
      refine Domain.YieldSeq.comp hprod ?_
      rw [List.append_nil, htail]
      have : (binDom d).toDomain.YieldSeq
          ([encTask ((d.bd m).getI k)] ++ [Sum.inr (hName m (k + 1))]) (u ++ (v ++ [nopA])) :=
        hu.append hrec
      simpa [List.append_assoc] using this

/-- The compiled description refines the doubled name of a source compound task into the source
refinements of that task, with no-ops added. -/
theorem yieldSeq_head (d : DomDesc) {m : ℕ} (hm : m < d.methods.length) {ys : List ℕ}
    (hys : (binDom d).toDomain.YieldSeq (emb (d.bd m)) ys) :
    ∃ zs, (binDom d).toDomain.YieldSeq [Sum.inr (2 * d.hd m)] zs ∧ dec zs = dec ys := by
  by_cases hnil : (d.bd m).length = 0
  · have hbd : d.bd m = [] := List.eq_nil_of_length_eq_zero hnil
    rw [hbd] at hys
    have hy : ys = [] := by
      simp only [emb_nil] at hys
      cases hys
      rfl
    subst hy
    refine ⟨[nopA, nopA], ?_, by simp⟩
    have hprod : (binDom d).toDomain.SeqBody (2 * d.hd m) [nopTask, nopTask] :=
      (seqBody_binDom_iff d).2 (Or.inl ⟨m, hm, hnil, rfl, rfl⟩)
    refine Domain.YieldSeq.comp hprod ?_
    have : (binDom d).toDomain.YieldSeq ([nopTask] ++ [nopTask]) ([nopA] ++ [nopA]) :=
      (yieldSeq_nopTask d).append (yieldSeq_nopTask d)
    simpa using this
  · have hpos : 0 < (d.bd m).length := by omega
    have hhead : headName d m 0 = 2 * d.hd m := by simp [headName]
    have := yieldSeq_chain d hm ((d.bd m).length) 0 (by omega) hpos ys (by simpa using hys)
    rw [hhead] at this
    exact ⟨ys ++ [nopA], this, by simp⟩

/-- **Every refinement of the source description is one of the compiled description**, up to the
no-ops the chains insert. -/
theorem exists_yieldSeq_binDom (hTO : DomDesc.MethodsTO d) {xs : List (ℕ ⊕ ℕ)} {as : List ℕ}
    (h : d.toDomain.YieldSeq xs as) :
    ∃ as', (binDom d).toDomain.YieldSeq (emb xs) as' ∧ dec as' = as := by
  induction h with
  | nil => exact ⟨[], Domain.YieldSeq.nil, rfl⟩
  | @prim a xs as _ ih =>
    obtain ⟨as', hy, hdec⟩ := ih
    exact ⟨2 * a :: as', Domain.YieldSeq.prim hy, by simp [hdec]⟩
  | @comp c bs xs as hm _ ih =>
    obtain ⟨as', hy, hdec⟩ := ih
    obtain ⟨m, hmlt, hhd, hbd⟩ := (DomDesc.seqBody_iff hTO).1 hm
    rw [emb_append] at hy
    obtain ⟨u, v, rfl, hu, hv⟩ := hy.split
    rw [← hbd] at hu
    obtain ⟨zs, hzs, hzdec⟩ := yieldSeq_head d hmlt hu
    rw [hhd] at hzs
    refine ⟨zs ++ v, ?_, ?_⟩
    · have : (binDom d).toDomain.YieldSeq ([Sum.inr (2 * c)] ++ emb xs) (zs ++ v) :=
        hzs.append hv
      simpa using this
    · rw [dec_append, hzdec, ← dec_append, hdec]

/-! ### From the compiled description back to the source -/

/-- **The intermediate task sequences of a derivation of the compiled description.**
`Corr d ys xs` says that the compiled task sequence `ys` stands for the source task sequence
`xs`: encoded tasks stand for themselves, no-ops stand for nothing, and the helper name
`H(m,k)` stands for the suffix of the body of the method `m` from position `k` on. -/
inductive Corr (d : DomDesc) : List (ℕ ⊕ ℕ) → List (ℕ ⊕ ℕ) → Prop
  /-- The empty sequence. -/
  | nil : Corr d [] []
  /-- An encoded task. -/
  | cons {y : ℕ ⊕ ℕ} {ys xs : List (ℕ ⊕ ℕ)} (h : Corr d ys xs) :
      Corr d (encTask y :: ys) (y :: xs)
  /-- A no-op. -/
  | nop {ys xs : List (ℕ ⊕ ℕ)} (h : Corr d ys xs) : Corr d (nopTask :: ys) xs
  /-- A suspended helper task. -/
  | susp {m k : ℕ} {ys xs : List (ℕ ⊕ ℕ)} (hk : 1 ≤ k) (h : Corr d ys xs) :
      Corr d (Sum.inr (hName m k) :: ys) ((d.bd m).drop k ++ xs)

/-- An encoded task sequence stands for itself. -/
theorem corr_emb (d : DomDesc) (xs : List (ℕ ⊕ ℕ)) : Corr d (emb xs) xs := by
  induction xs with
  | nil => exact Corr.nil
  | cons x xs ih => exact Corr.cons ih

/-- Inversion of `Corr` at a non-empty compiled task sequence. -/
theorem corr_cons_inv {z : ℕ ⊕ ℕ} {ys xs : List (ℕ ⊕ ℕ)} (h : Corr d (z :: ys) xs) :
    (∃ y xs', z = encTask y ∧ xs = y :: xs' ∧ Corr d ys xs') ∨
    (z = nopTask ∧ Corr d ys xs) ∨
    (∃ m k xs', 1 ≤ k ∧ z = Sum.inr (hName m k) ∧ xs = (d.bd m).drop k ++ xs' ∧
      Corr d ys xs') := by
  cases h with
  | cons hc => exact Or.inl ⟨_, _, rfl, rfl, hc⟩
  | nop hc => exact Or.inr (Or.inl ⟨rfl, hc⟩)
  | susp hk hc => exact Or.inr (Or.inr ⟨_, _, _, hk, rfl, rfl, hc⟩)

/-- The body of the `k`-th method of a chain stands for the suffix of the source body it
replaces. -/
theorem corr_body {m k : ℕ} (hk : k < (d.bd m).length) {ys xs : List (ℕ ⊕ ℕ)}
    (hc : Corr d ys xs) :
    Corr d ([encTask ((d.bd m).getI k), tailTask d m k] ++ ys) ((d.bd m).drop k ++ xs) := by
  have hdrop : (d.bd m).drop k = (d.bd m).getI k :: (d.bd m).drop (k + 1) := by
    rw [List.getI_eq_getElem (l := d.bd m) hk]
    exact List.drop_eq_getElem_cons hk
  rw [hdrop, List.cons_append]
  by_cases hlast : k + 1 = (d.bd m).length
  · have htail : tailTask d m k = nopTask := by simp [tailTask, hlast]
    have hnil : (d.bd m).drop (k + 1) = [] := List.drop_eq_nil_of_le (by omega)
    rw [htail, hnil]
    exact Corr.cons (Corr.nop hc)
  · have htail : tailTask d m k = Sum.inr (hName m (k + 1)) := by simp [tailTask, hlast]
    rw [htail]
    exact Corr.cons (Corr.susp (by omega) hc)

/-- **Every refinement of the compiled description decodes to a refinement of the source.** -/
theorem yieldSeq_of_corr (hTO : DomDesc.MethodsTO d) {ys : List (ℕ ⊕ ℕ)} {as : List ℕ}
    (h : (binDom d).toDomain.YieldSeq ys as) :
    ∀ xs, Corr d ys xs → d.toDomain.YieldSeq xs (dec as) := by
  induction h with
  | nil =>
    intro xs hcorr
    cases hcorr
    exact Domain.YieldSeq.nil
  | @prim a ys as _ ih =>
    intro xs hcorr
    rcases corr_cons_inv hcorr with ⟨y, xs', hz, rfl, hc⟩ | ⟨hz, hc⟩ |
      ⟨m, k, xs', hk, hz, -, -⟩
    · cases y with
      | inl a₀ =>
        have ha : a = 2 * a₀ := by
          have : (Sum.inl a : ℕ ⊕ ℕ) = Sum.inl (2 * a₀) := hz
          simpa using this
        subst ha
        rw [dec_cons_double]
        exact Domain.YieldSeq.prim (ih _ hc)
      | inr c₀ => exact absurd hz (by simp [encTask])
    · have ha : a = nopA := by
        have : (Sum.inl a : ℕ ⊕ ℕ) = Sum.inl nopA := hz
        simpa using this
      subst ha
      rw [dec_cons_nop]
      exact ih _ hc
    · exact absurd hz (by simp)
  | @comp c' bs' ys as hprod _ ih =>
    intro xs hcorr
    rcases corr_cons_inv hcorr with ⟨y, xs', hz, rfl, hc⟩ | ⟨hz, -⟩ |
      ⟨m, k, xs', hk1, hz, rfl, hc⟩
    · cases y with
      | inl a₀ => exact absurd hz (by simp [encTask])
      | inr c =>
        have hc' : c' = 2 * c := by
          have : (Sum.inr c' : ℕ ⊕ ℕ) = Sum.inr (2 * c) := hz
          simpa using this
        subst hc'
        rcases (seqBody_binDom_iff d).1 hprod with
          ⟨m, hm, hlen, hhead, rfl⟩ | ⟨m, k, hm, hk, hhead, rfl⟩
        · have hhd : d.hd m = c := by omega
          have hbd : d.bd m = [] := List.eq_nil_of_length_eq_zero hlen
          have hsrc : d.toDomain.SeqBody c (d.bd m) :=
            (DomDesc.seqBody_iff hTO).2 ⟨m, hm, hhd, rfl⟩
          refine Domain.YieldSeq.comp hsrc ?_
          rw [hbd, List.nil_append]
          exact ih _ (Corr.nop (Corr.nop hc))
        · have hk0 : k = 0 := by
            by_contra hne
            have hhn : headName d m k = hName m k := by simp [headName, hne]
            rw [hhn] at hhead
            exact hName_ne_double m k c hhead.symm
          subst hk0
          have hhd : d.hd m = c := by
            have hhn : headName d m 0 = 2 * d.hd m := by simp [headName]
            rw [hhn] at hhead
            omega
          have hsrc : d.toDomain.SeqBody c (d.bd m) :=
            (DomDesc.seqBody_iff hTO).2 ⟨m, hm, hhd, rfl⟩
          refine Domain.YieldSeq.comp hsrc (ih _ ?_)
          simpa using corr_body (m := m) (k := 0) hk hc
    · exact absurd hz (by simp [nopTask])
    · have hc' : c' = hName m k := by
        have : (Sum.inr c' : ℕ ⊕ ℕ) = Sum.inr (hName m k) := hz
        simpa using this
      subst hc'
      rcases (seqBody_binDom_iff d).1 hprod with
        ⟨m', hm', hlen', hhead', rfl⟩ | ⟨m', k', hm', hk', hhead', rfl⟩
      · exact absurd hhead' (hName_ne_double m k (d.hd m'))
      · have hk'0 : k' ≠ 0 := by
          intro hzero
          subst hzero
          have hhn : headName d m' 0 = 2 * d.hd m' := by simp [headName]
          rw [hhn] at hhead'
          exact hName_ne_double m k (d.hd m') hhead'
        have hheq : hName m k = hName m' k' := by
          have hhn : headName d m' k' = hName m' k' := by simp [headName, hk'0]
          rw [hhn] at hhead'
          exact hhead'
        obtain ⟨rfl, rfl⟩ := hName_inj hheq
        exact ih _ (corr_body hk' hc)


/-! ### Solvability -/

/-- **The binarisation preserves and reflects solvability.**  The source domain description is
totally ordered, the source instance description is rooted. -/
theorem solvable_bin_iff {q : InstDesc} (hTO : DomDesc.MethodsTO d)
    (hroot : InstDesc.IsRooted q) : Solvable (binDom d) (binInst q) ↔ Solvable d q := by
  obtain ⟨t₀, c₀, hT, hα⟩ := hroot
  have hrootq : InstDesc.IsRooted q := ⟨t₀, c₀, hT, hα⟩
  obtain ⟨hT', hα'⟩ := binInst_root hT hα
  have hseq : (problem d q).tnI.IsSeqNet [t₀] [Sum.inr c₀] := by
    have h := TaskNetwork.isSeqNet_singleton (problem_wf d q).tnI hT
    have hα'' : (problem d q).tnI.α t₀ = Sum.inr c₀ := hα
    rwa [hα''] at h
  have hseq' : (problem (binDom d) (binInst q)).tnI.IsSeqNet [t₀] [Sum.inr (2 * c₀)] := by
    have h := TaskNetwork.isSeqNet_singleton (problem_wf (binDom d) (binInst q)).tnI hT'
    have hα'' : (problem (binDom d) (binInst q)).tnI.α t₀ = Sum.inr (2 * c₀) := hα'
    rwa [hα''] at h
  have hTOm : (problem d q).IsTO_M := (isTO_problem hTO hrootq.isTO).2
  have hTOm' : (problem (binDom d) (binInst q)).IsTO_M :=
    (isTO_problem (binDom_methodsTO d) (binInst_isRooted hrootq).isTO).2
  have hsrc : Solvable d q ↔ ∃ as : List ℕ, d.toDomain.YieldSeq [Sum.inr c₀] as ∧
      d.toDomain.SeqApplicable as {f | f ∈ q.initList} ∧
      {f | f ∈ q.goalList} ⊆ d.toDomain.transitionSeq as {f | f ∈ q.initList} :=
    Problem.solvable_iff_yieldSeq (problem_wf d q) hTOm hseq
  have htgt : Solvable (binDom d) (binInst q) ↔ ∃ as : List ℕ,
      (binDom d).toDomain.YieldSeq [Sum.inr (2 * c₀)] as ∧
      (binDom d).toDomain.SeqApplicable as {f | f ∈ q.initList} ∧
      {f | f ∈ q.goalList} ⊆ (binDom d).toDomain.transitionSeq as {f | f ∈ q.initList} :=
    Problem.solvable_iff_yieldSeq (problem_wf (binDom d) (binInst q)) hTOm' hseq'
  rw [hsrc, htgt]
  constructor
  · rintro ⟨as', hy, happ, hgoal⟩
    refine ⟨dec as', ?_, (seqApplicable_bin d as' _).1 happ, ?_⟩
    · exact yieldSeq_of_corr hTO hy _ (by simpa using corr_emb d [Sum.inr c₀])
    · rw [← transitionSeq_bin d as' {f | f ∈ q.initList}]
      exact hgoal
  · rintro ⟨as, hy, happ, hgoal⟩
    obtain ⟨as', hy', hdec⟩ := exists_yieldSeq_binDom hTO hy
    refine ⟨as', by simpa using hy', ?_, ?_⟩
    · rw [seqApplicable_bin d as' _, hdec]
      exact happ
    · rw [transitionSeq_bin d as' {f | f ∈ q.initList}, hdec]
      exact hgoal

end Binarise

end Syn

end HTN
