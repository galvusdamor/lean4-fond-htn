import HtnPlanning.Core.Construction
import HtnPlanning.Core.ProofTuples
/-!
# Compiling totally ordered HTN problems into acyclic ones

This file formalises the construction of the draft paper `compilation.tex`,

> **Theorem.** TO-HTN is poly-compilable to HTN-AC,

whose proof simulates the EXPTIME-membership argument of Erol, Hendler and Nau: a plan of the
compiled problem is a *proof* that a plan of the original problem exists, in the form of a list
of triples `(s, T, s')`; see `HtnPlanning/Core/ProofTuples.lean` for the formalisation of
that characterisation and of its correctness (`HTN.Domain.provable_iff_yield`).

As in the source, methods of the source domain are assumed to have at most two subtasks.

## The construction

*Facts.*  `key₀`, `key₁^X` and `key₂^X` for `X ∈ {R, W}` (control of the plan), five copies
`v^1 … v^5` of every fact `v` of the source problem, and one fact per task name of the source
domain (`HTN.ToAc.AcFact`).

**Deviation from the source.**  The source uses the *negative* preconditions
`preNV_n^{i,j} : ¬v_n^i, ¬v_n^j`.  The action model formalised in this project (like STRIPS)
has no negative preconditions, so every state copy `v^i` is represented by the two
complementary facts `pos v i` and `neg v i`, which `setV`/`delV` keep complementary; `preNV`
then tests the facts `neg v i`, `neg v j`.  This is the standard way of removing negative
preconditions and it doubles the number of facts only.

*Actions* (`HTN.ToAc.AcAct`, Table 1 of the source): `setV`, `delV`, `prePV`, `preNV`, `setC`,
`preC`, `lock`, `unlock`, `ask_X`, `accept_X`, `done_X`, `wait_X` and, for every operator `o` of
the source domain, the action `o²` executing `o` on the second copy of the state.

*Compound tasks* (`HTN.ToAc.AcTask`): `SEL^i`, `SEL_n^i` (guessing a state into copy `i`),
`EQ^{i,j}`, `EQ_n^{i,j}` (comparing two copies), `STATE_n^1`, `STATE_n^3` and `MEM` (a memory
cell holding one proved triple), `READ`, `WRITE`, `TUPLE` (one proof step), the counting tasks
`𝔠̄^k_T` (`cnt`) and `𝔠^k_T` (`cntPar`), and the initial task `t_I`.

**Two further deviations**, both forced by gaps in the draft: the printed `TUPLE` methods never
*set* the task name of the triple they write, so a `setC` action for the decomposed task is
added before the copies of `WRITE`; and the second family of `TUPLE` methods is indexed by the
operators of the source domain (the draft repeats "for `T ↦ AB ∈ M`", which must be a typo).

## What is proved here

* `HTN.ToAc.wf` — the compiled problem is well formed;
* `HTN.ToAc.isAcyclic`, `HTN.ToAc.mem_HTN_AC` — **the compiled problem is acyclic**, i.e. it
  belongs to the target class `HTN-AC`.  This is the essential structural claim of the
  construction and is proved via the explicit rank function `HTN.ToAc.rank`;
* `HTN.ToAc.method_card_le`, `HTN.ToAc.method_size_le` — every method of the compiled domain
  has at most `30` subtasks and size at most `931`, bounds independent of the number of copies
  of the memory (which is exponential), because the copies are generated by the counting tasks;
  together with `HTN.card_halvingClosure_le` (only logarithmically many counting tasks are
  needed) this is the size statement of the construction.

The *correctness* of the compilation (a solution of the compiled problem exists iff the source
problem is solvable) is not proved; see `NOTES.md`.  Its two halves are the proof-tuple
characterisation `HTN.Domain.provable_iff_yield`, which *is* proved, and the simulation of the
proof-tuple derivation by the `TUPLE`/`MEM` tasks, which is not.
-/

namespace HTN

namespace ToAc

/-- The two synchronisation channels of the construction: reading from and writing to a memory
cell. -/
inductive RW
  /-- Reading a memory cell. -/
  | read
  /-- Writing a memory cell. -/
  | write
  deriving DecidableEq, Repr, Inhabited

/-- The facts of the compiled problem. -/
inductive AcFact (F A C : Type)
  /-- `key₀`: no `TUPLE` task is currently being executed. -/
  | key0
  /-- `key₁^X`. -/
  | key1 (x : RW)
  /-- `key₂^X`. -/
  | key2 (x : RW)
  /-- The `i`-th copy of the fact `v` is true. -/
  | pos (v : F) (i : Fin 5)
  /-- The `i`-th copy of the fact `v` is false (complement of `pos`, used in place of the
  negative preconditions of the source). -/
  | neg (v : F) (i : Fin 5)
  /-- The task name currently stored in the triple. -/
  | task (t : A ⊕ C)

/-- The actions of the compiled problem (Table 1 of the source). -/
inductive AcAct (F A C : Type)
  /-- `setV_n^i`. -/
  | setV (v : F) (i : Fin 5)
  /-- `delV_n^i`. -/
  | delV (v : F) (i : Fin 5)
  /-- `prePV_n^{i,j}`. -/
  | prePV (v : F) (i j : Fin 5)
  /-- `preNV_n^{i,j}`. -/
  | preNV (v : F) (i j : Fin 5)
  /-- `setC_n`. -/
  | setC (t : A ⊕ C)
  /-- `preC_n`. -/
  | preC (t : A ⊕ C)
  /-- `lock`. -/
  | lock
  /-- `unlock`. -/
  | unlock
  /-- `ask_X`. -/
  | ask (x : RW)
  /-- `accept_X`. -/
  | accept (x : RW)
  /-- `done_X`. -/
  | doneA (x : RW)
  /-- `wait_X`. -/
  | waitA (x : RW)
  /-- `o²`: the operator `o` of the source domain, executed on the second copy of the state. -/
  | op2 (o : A)

/-- The compound tasks of the compiled problem. -/
inductive AcTask (F A C : Type)
  /-- `SEL^i`: guess a state into the `i`-th copy. -/
  | SEL (i : Fin 5)
  /-- `SEL_n^i`: guess the first `n` facts into the `i`-th copy. -/
  | SELn (n : ℕ) (i : Fin 5)
  /-- `EQ^{i,j}`: check that the copies `i` and `j` agree. -/
  | EQ (i j : Fin 5)
  /-- `EQ_n^{i,j}`. -/
  | EQn (n : ℕ) (i j : Fin 5)
  /-- `STATE_n^1`: read the first copy and write the fourth. -/
  | STATE1 (n : ℕ)
  /-- `STATE_n^3`: read the third copy and write the fifth. -/
  | STATE3 (n : ℕ)
  /-- `MEM`: a memory cell holding one proved triple. -/
  | MEM
  /-- `WRITE`. -/
  | WRITE
  /-- `READ`. -/
  | READ
  /-- `TUPLE`: one step of the proof. -/
  | TUPLE
  /-- `𝔠̄^k_T`: at most `k` totally ordered copies of `T`. -/
  | cnt (t : AcTask F A C) (k : ℕ)
  /-- `𝔠^k_T`: at most `k` unordered copies of `T`. -/
  | cntPar (t : AcTask F A C) (k : ℕ)
  /-- The initial compound task `t_I` of the compiled problem. -/
  | tI

variable {F A C : Type}

instance : Inhabited (AcAct F A C) := ⟨.lock⟩
instance : Inhabited (AcTask F A C) := ⟨.tI⟩

/-! ### The action model -/

/-- Preconditions of the compiled actions. -/
def prec (D : ActionModel F A) : AcAct F A C → Set (AcFact F A C)
  | .setV _ _ => ∅
  | .delV _ _ => ∅
  | .prePV v i j => {AcFact.pos v i, AcFact.pos v j}
  | .preNV v i j => {AcFact.neg v i, AcFact.neg v j}
  | .setC _ => ∅
  | .preC t => {AcFact.task t}
  | .lock => {AcFact.key0}
  | .unlock => ∅
  | .ask _ => ∅
  | .accept x => {AcFact.key1 x}
  | .doneA _ => ∅
  | .waitA x => {AcFact.key2 x}
  | .op2 o => (fun v => AcFact.pos v 1) '' D.prec o

/-- Add effects of the compiled actions. -/
def add (D : ActionModel F A) : AcAct F A C → Set (AcFact F A C)
  | .setV v i => {AcFact.pos v i}
  | .delV v i => {AcFact.neg v i}
  | .prePV _ _ _ => ∅
  | .preNV _ _ _ => ∅
  | .setC t => {AcFact.task t}
  | .preC _ => ∅
  | .lock => ∅
  | .unlock => {AcFact.key0}
  | .ask x => {AcFact.key1 x}
  | .accept _ => ∅
  | .doneA x => {AcFact.key2 x}
  | .waitA _ => ∅
  | .op2 o => (fun v => AcFact.pos v 1) '' D.add o ∪ (fun v => AcFact.neg v 1) '' D.del o

/-- Delete effects of the compiled actions. -/
def del (D : ActionModel F A) : AcAct F A C → Set (AcFact F A C)
  | .setV v i => {AcFact.neg v i}
  | .delV v i => {AcFact.pos v i}
  | .prePV _ _ _ => ∅
  | .preNV _ _ _ => ∅
  | .setC t => {f | ∃ t', f = AcFact.task t' ∧ t' ≠ t}
  | .preC _ => ∅
  | .lock => {AcFact.key0}
  | .unlock => ∅
  | .ask _ => ∅
  | .accept x => {AcFact.key1 x}
  | .doneA _ => ∅
  | .waitA x => {AcFact.key2 x}
  | .op2 o => (fun v => AcFact.neg v 1) '' D.add o ∪ (fun v => AcFact.pos v 1) '' D.del o

/-- The action model of the compiled problem. -/
def actionModel (D : ActionModel F A) : ActionModel (AcFact F A C) (AcAct F A C) where
  prec := prec D
  add := add D
  del := del D

/-! ### The methods -/

section Bodies

variable {I : Type} (D : Domain F A C I) (vars : List F) (bound : ℕ)

/-- The method bodies of the compiled domain, as lists of parallel chains.  `vars` is the list
of facts of the source problem and `bound` the number of memory cells (`2^{|V|+1}·|C ∪ O|` in
the source). -/
def bodies : AcTask F A C → Set (List (List (AcAct F A C ⊕ AcTask F A C)))
  | .SEL i => {[[Sum.inr (.SELn vars.length i)]]}
  | .SELn n i =>
      if n = 0 then {[]}
      else {ls | ∃ v ∈ vars[n - 1]?,
        (ls = [[Sum.inl (.setV v i), Sum.inr (.SELn (n - 1) i)]] ∨
         ls = [[Sum.inl (.delV v i), Sum.inr (.SELn (n - 1) i)]])}
  | .EQ i j => {[[Sum.inr (.EQn vars.length i j)]]}
  | .EQn n i j =>
      if n = 0 then {[]}
      else {ls | ∃ v ∈ vars[n - 1]?,
        (ls = [[Sum.inl (.prePV v i j), Sum.inr (.EQn (n - 1) i j)]] ∨
         ls = [[Sum.inl (.preNV v i j), Sum.inr (.EQn (n - 1) i j)]])}
  | .STATE1 n =>
      if n = 0 then {[[Sum.inr (.STATE3 vars.length)]]}
      else {ls | ∃ v ∈ vars[n - 1]?,
        (ls = [[Sum.inl (.prePV v 0 0), Sum.inr (.STATE1 (n - 1)), Sum.inl (.setV v 3)]] ∨
         ls = [[Sum.inl (.preNV v 0 0), Sum.inr (.STATE1 (n - 1)), Sum.inl (.delV v 3)]])}
  | .STATE3 n =>
      if n = 0 then
        {ls | ∃ t : A ⊕ C, ls = [[Sum.inl (.preC t), Sum.inl (.doneA .write),
          Sum.inl (.accept .read), Sum.inl (.setC t)]]}
      else {ls | ∃ v ∈ vars[n - 1]?,
        (ls = [[Sum.inl (.prePV v 2 2), Sum.inr (.STATE3 (n - 1)), Sum.inl (.setV v 4)]] ∨
         ls = [[Sum.inl (.preNV v 2 2), Sum.inr (.STATE3 (n - 1)), Sum.inl (.delV v 4)]])}
  | .MEM => {[[Sum.inl (.accept .write), Sum.inr (.STATE1 vars.length),
      Sum.inl (.doneA .read)]]}
  | .WRITE => {[[Sum.inl (.ask .write), Sum.inl (.waitA .write)]]}
  | .READ => {[[Sum.inl (.ask .read), Sum.inl (.waitA .read)]]}
  | .TUPLE =>
      {ls | ∃ (c : C) (x y : A ⊕ C), D.SeqBody c [x, y] ∧ ls =
        [[Sum.inl .lock, Sum.inr (.SEL 0), Sum.inr (.SEL 1), Sum.inr (.SEL 2),
          Sum.inr .READ, Sum.inr (.EQ 0 3), Sum.inr (.EQ 1 4), Sum.inl (.preC x),
          Sum.inr .READ, Sum.inr (.EQ 1 3), Sum.inr (.EQ 2 4), Sum.inl (.preC y),
          Sum.inl (.setC (Sum.inr c)), Sum.inr (.cnt .WRITE bound), Sum.inl .unlock]]} ∪
      {ls | ∃ o : A, ls =
        [[Sum.inl .lock, Sum.inr (.SEL 0), Sum.inr (.SEL 1), Sum.inr (.SEL 2),
          Sum.inr (.EQ 0 1), Sum.inl (.op2 o), Sum.inr (.EQ 1 2),
          Sum.inl (.setC (Sum.inl o)), Sum.inr (.cnt .WRITE bound), Sum.inl .unlock]]}
  | .cnt t k =>
      if k = 0 then {[]}
      else if k = 1 then {[[Sum.inr t]], []}
      else if k % 2 = 0 then {[[Sum.inr (.cnt t (k / 2)), Sum.inr (.cnt t (k / 2))]]}
      else {[[Sum.inr t, Sum.inr (.cnt t (k - 1))]], [[Sum.inr (.cnt t (k - 1))]]}
  | .cntPar t k =>
      if k = 0 then {[]}
      else if k = 1 then {[[Sum.inr t]], []}
      else if k % 2 = 0 then
        {[[Sum.inr (.cntPar t (k / 2))], [Sum.inr (.cntPar t (k / 2))]]}
      else {[[Sum.inr t], [Sum.inr (.cntPar t (k - 1))]], [[Sum.inr (.cntPar t (k - 1))]]}
  | .tI => {[[Sum.inr (.cntPar .MEM bound)], [Sum.inr (.cntPar .TUPLE bound)]]}

/-- The methods of the compiled domain. -/
def methods : Set (Method (ℕ × ℕ) (AcAct F A C) (AcTask F A C)) :=
  {m | ∃ ls ∈ bodies D vars bound m.abstractTask, m.subtasks = TaskNetwork.grid ls}

/-- The compiled domain. -/
def domain : Domain (AcFact F A C) (AcAct F A C) (AcTask F A C) (ℕ × ℕ) where
  toActionModel := actionModel D.toActionModel
  methods := methods D vars bound

end Bodies

section Instance

variable {I : Type} (Q : Instance F A C I) (tI0 : C)

/-- The compiled problem instance: initially only `key₀` holds and all copies of all facts are
false; the goal demands that the fourth copy is the initial state of the source problem, the
fifth copy satisfies its goal, and the stored task is the initial compound task. -/
def instance_ : Instance (AcFact F A C) (AcAct F A C) (AcTask F A C) (ℕ × ℕ) where
  init := {AcFact.key0} ∪ {f | ∃ (v : F) (i : Fin 5), f = AcFact.neg v i}
  goal := (fun v => AcFact.pos v 3) '' Q.init ∪ (fun v => AcFact.pos v 4) '' Q.goal ∪
    {AcFact.task (Sum.inr tI0)}
  tnI := TaskNetwork.seq [Sum.inr AcTask.tI]

end Instance

/-- The compiled HTN planning problem. -/
def problem {I : Type} (D : Domain F A C I) (Q : Instance F A C I) (vars : List F)
    (bound : ℕ) (tI0 : C) : Problem (AcFact F A C) (AcAct F A C) (AcTask F A C) (ℕ × ℕ) :=
  (domain D vars bound).mkProblem (instance_ Q tI0)

/-! ### Well-formedness -/

section Structure

variable {I : Type} (D : Domain F A C I) (Q : Instance F A C I) (vars : List F) (bound : ℕ)
  (tI0 : C)

lemma methods_wf : ∀ m ∈ methods D vars bound, m.subtasks.WF := by
  rintro ⟨c, tn⟩ ⟨ls, -, rfl⟩
  exact TaskNetwork.grid_wf

/-- **The compiled problem is well formed.** -/
theorem wf : (problem D Q vars bound tI0).WF where
  tnI := TaskNetwork.seq_wf
  methods := methods_wf D vars bound

end Structure

/-! ### Acyclicity -/

/-- The rank of a compound task of the compiled domain: a natural number that strictly
decreases along every method, witnessing acyclicity.  `n` is the number of facts of the source
problem and `b` the number of memory cells. -/
def rank (n b : ℕ) : AcTask F A C → ℕ
  | .SEL _ => n + 1
  | .SELn k _ => k
  | .EQ _ _ => n + 1
  | .EQn k _ _ => k
  | .STATE1 k => n + 1 + k
  | .STATE3 k => k
  | .MEM => 2 * n + 3
  | .WRITE => 0
  | .READ => 0
  | .TUPLE => n + b + 4
  | .cnt t k => rank n b t + 1 + k
  | .cntPar t k => rank n b t + 1 + k
  | .tI => 3 * n + 2 * b + 20

section Acyclic

variable {I : Type} {D : Domain F A C I} {Q : Instance F A C I} {vars : List F} {bound : ℕ}
  {tI0 : C}

local macro "flatten_rank" h:ident : tactic =>
  `(tactic| (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.cons_append,
      List.nil_append, List.mem_cons, List.mem_append, List.not_mem_nil,
      or_false, false_or, reduceCtorEq, Sum.inr.injEq, Sum.inl.injEq] at $h:ident <;>
      (try casesm* _ ∧ _, _ ∨ _) <;> subst_vars <;> simp only [rank] <;> omega))

/-- Every compound task occurring in a method body has a strictly smaller rank than the task
that the method decomposes. -/
lemma rank_lt_of_mem_bodies {t : AcTask F A C} {ls : List (List (AcAct F A C ⊕ AcTask F A C))}
    (hls : ls ∈ bodies D vars bound t) {c : AcTask F A C} (hc : Sum.inr c ∈ ls.flatten) :
    rank vars.length bound c < rank vars.length bound t := by
  cases t with
  | SEL i => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | SELn k i =>
      simp only [bodies] at hls
      split_ifs at hls with hk
      · simp only [Set.mem_singleton_iff] at hls; subst hls; simp at hc
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (have : 0 < k := Nat.pos_of_ne_zero hk) <;> flatten_rank hc
  | EQ i j => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | EQn k i j =>
      simp only [bodies] at hls
      split_ifs at hls with hk
      · simp only [Set.mem_singleton_iff] at hls; subst hls; simp at hc
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (have : 0 < k := Nat.pos_of_ne_zero hk) <;> flatten_rank hc
  | STATE1 k =>
      simp only [bodies] at hls
      split_ifs at hls with hk
      · subst hk
        simp only [Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (have : 0 < k := Nat.pos_of_ne_zero hk) <;> flatten_rank hc
  | STATE3 k =>
      simp only [bodies] at hls
      split_ifs at hls with hk
      · obtain ⟨t', rfl⟩ := hls; flatten_rank hc
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (have : 0 < k := Nat.pos_of_ne_zero hk) <;> flatten_rank hc
  | MEM => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | WRITE => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | READ => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | TUPLE =>
      rcases hls with ⟨c₀, x, y, -, rfl⟩ | ⟨o, rfl⟩ <;> flatten_rank hc
  | cnt t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he
      · subst hls; simp at hc
      · subst h1
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        rcases hls with rfl | rfl
        · flatten_rank hc
        · simp at hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hk : 2 ≤ k := by omega
        flatten_rank hc
      · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        have hk : 2 ≤ k := by omega
        rcases hls with rfl | rfl <;> flatten_rank hc
  | cntPar t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he
      · subst hls; simp at hc
      · subst h1
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        rcases hls with rfl | rfl
        · flatten_rank hc
        · simp at hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hk : 2 ≤ k := by omega
        flatten_rank hc
      · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        have hk : 2 ≤ k := by omega
        rcases hls with rfl | rfl <;> flatten_rank hc
  | tI => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc

/-- **The compiled problem is acyclic.** -/
theorem isAcyclic : (problem D Q vars bound tI0).IsAcyclic := by
  refine Problem.isAcyclic_of_rank _ (rank vars.length bound) ?_
  rintro ⟨ct, tn⟩ ⟨⟨ls, hls, rfl⟩, -⟩ t ht c hc
  refine rank_lt_of_mem_bodies hls ?_
  have hmem := TaskNetwork.grid_α_mem_flatten (ls := ls) ht
  rwa [hc] at hmem

/-- **The compiled problem belongs to the class `HTN-AC`.** -/
theorem mem_HTN_AC : problem D Q vars bound tI0 ∈
    Classes.HTN_AC (AcFact F A C) (AcAct F A C) (AcTask F A C) (ℕ × ℕ) := isAcyclic

end Acyclic

/-! ### The size of the compilation -/

section Size

variable {I : Type} {D : Domain F A C I} {vars : List F} {bound : ℕ}

/-- Every method body consists of at most two parallel chains of at most fifteen tasks each. -/
lemma bodies_small {t : AcTask F A C} {ls : List (List (AcAct F A C ⊕ AcTask F A C))}
    (hls : ls ∈ bodies D vars bound t) : ls.length ≤ 2 ∧ ∀ l ∈ ls, l.length ≤ 15 := by
  cases t with
  | SEL i => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | SELn k i =>
      simp only [bodies] at hls
      split_ifs at hls
      · simp only [Set.mem_singleton_iff] at hls; subst hls; simp
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;> simp
  | EQ i j => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | EQn k i j =>
      simp only [bodies] at hls
      split_ifs at hls
      · simp only [Set.mem_singleton_iff] at hls; subst hls; simp
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;> simp
  | STATE1 k =>
      simp only [bodies] at hls
      split_ifs at hls with hk
      · simp only [Set.mem_singleton_iff] at hls; subst hls; simp
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;> simp
  | STATE3 k =>
      simp only [bodies] at hls
      split_ifs at hls with hk
      · obtain ⟨t', rfl⟩ := hls; simp
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;> simp
  | MEM => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | WRITE => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | READ => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | TUPLE => rcases hls with ⟨c₀, x, y, -, rfl⟩ | ⟨o, rfl⟩ <;> simp
  | cnt t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he <;>
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
      · subst hls; simp
      · rcases hls with rfl | rfl <;> simp
      · subst hls; simp
      · rcases hls with rfl | rfl <;> simp
  | cntPar t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he <;>
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
      · subst hls; simp
      · rcases hls with rfl | rfl <;> simp
      · subst hls; simp
      · rcases hls with rfl | rfl <;> simp
  | tI => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp

/-- **Every method of the compiled domain has at most `30` subtasks**, independently of the
(exponentially large) number of memory cells. -/
theorem method_card_le {m : Method (ℕ × ℕ) (AcAct F A C) (AcTask F A C)}
    (hm : m ∈ methods D vars bound) : m.subtasks.T.card ≤ 30 := by
  obtain ⟨ct, tn⟩ := m
  obtain ⟨ls, hls, rfl⟩ := hm
  obtain ⟨h1, h2⟩ := bodies_small hls
  calc (TaskNetwork.grid ls).T.card ≤ ls.length * 15 := TaskNetwork.grid_card_le h2
    _ ≤ 30 := by omega

/-- **Every method of the compiled domain has size at most `931`.** -/
theorem method_size_le {m : Method (ℕ × ℕ) (AcAct F A C) (AcTask F A C)}
    (hm : m ∈ methods D vars bound) : m.size ≤ 931 := by
  have hc := method_card_le hm
  have h := m.subtasks.size_le
  have : m.subtasks.T.card * m.subtasks.T.card ≤ 30 * 30 := Nat.mul_le_mul hc hc
  simp only [Method.size]
  omega

end Size

