import HtnComplexity.TMEnc.EncodingSize
/-!
# A `Finset` presentation of the HTN-AC compilation

`HtnComplexity/ToHtnAc/ToHtnAc.lean` defines the compilation of totally ordered HTN problems into
acyclic ones by giving, for every compound task, the *set* of its method bodies
(`HTN.ToAc.bodies`).  Several of these sets are indexed by the facts, the operators or the
methods of the source domain, and the compound tasks of the compiled domain form an infinite
type (the counting tasks `𝔠̄^k`, `𝔠^k` are indexed by `k : ℕ`).  The size bounds proved so far
are therefore *per method* (`HTN.ToAc.method_size_le`) and relative to an arbitrary fragment
(`HTN.ToAc.sizeOn_le`).

This file supplies the missing ingredient for a *closed-form* polynomial size bound: a
presentation of the used part of the compiled domain by `Finset`s.

* `HTN.ToAc.taskFinset` — the finitely many compound tasks that the construction actually uses;
  it is closed under the method bodies (`HTN.ToAc.mem_taskFinset_of_mem_bodies`), so no
  decomposition ever leaves it.
* `HTN.ToAc.bodyFinset` — the bodies of one compound task as a `Finset`; it consists of genuine
  bodies (`HTN.ToAc.bodyFinset_subset_bodies`) and, if the source signature is covered, of *all*
  of them (`HTN.ToAc.bodies_subset_bodyFinset`).
* `HTN.ToAc.methodFinset`, `HTN.ToAc.fragment` — the resulting finite set of methods and the
  fragment of the compiled signature, with `HTN.ToAc.methodFinset_subset_methods`.
* `HTN.ToAc.card_methodFinset_le` and, for a finite source signature,
  **`HTN.ToAc.sizeOn_fragment_le`** — a closed-form bound on `HTN.Domain.sizeOn` of the compiled
  domain, polynomial in the number of facts, operators and compound tasks of the source and in
  `log₂` of the number of memory cells.  (The number of memory cells is exponential in the
  source, so the logarithm is the essential point: the exponentially many memory cells are
  generated by logarithmically many counting methods.)
-/

namespace HTN

namespace ToAc

open scoped Classical

variable {F A C I : Type}

/-! ### The compound tasks that are used -/

/-- The task names of the source signature, as a `Finset` of `A ⊕ C`. -/
noncomputable def nameFinset (ops : Finset A) (cs : Finset C) : Finset (A ⊕ C) :=
  ops.image Sum.inl ∪ cs.image Sum.inr

lemma card_nameFinset_le (ops : Finset A) (cs : Finset C) :
    (nameFinset ops cs).card ≤ ops.card + cs.card :=
  le_trans (Finset.card_union_le _ _)
    (Nat.add_le_add (Finset.card_image_le) (Finset.card_image_le))

lemma mem_nameFinset {ops : Finset A} {cs : Finset C} {t : A ⊕ C}
    (hops : ∀ o : A, o ∈ ops) (hcs : ∀ c : C, c ∈ cs) : t ∈ nameFinset ops cs := by
  cases t with
  | inl o => exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ (hops o))
  | inr c => exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ (hcs c))

/-- The compound tasks of the compiled domain that the construction uses: the guessing and
comparing tasks for the (at most `|vars|`) facts, the state-copying tasks, the memory and proof
tasks, and the counting tasks for the counts in the halving closure of the number of memory
cells. -/
noncomputable def taskFinset (vars : List F) (bound : ℕ) : Finset (AcTask F A C) :=
  (Finset.univ : Finset (Fin 5)).image AcTask.SEL ∪
  ((Finset.range (vars.length + 1)) ×ˢ (Finset.univ : Finset (Fin 5))).image
    (fun p => AcTask.SELn p.1 p.2) ∪
  ((Finset.univ : Finset (Fin 5)) ×ˢ (Finset.univ : Finset (Fin 5))).image
    (fun p => AcTask.EQ p.1 p.2) ∪
  ((Finset.range (vars.length + 1)) ×ˢ (Finset.univ : Finset (Fin 5)) ×ˢ
    (Finset.univ : Finset (Fin 5))).image (fun p => AcTask.EQn p.1 p.2.1 p.2.2) ∪
  (Finset.range (vars.length + 1)).image AcTask.STATE1 ∪
  (Finset.range (vars.length + 1)).image AcTask.STATE3 ∪
  {AcTask.MEM, AcTask.WRITE, AcTask.READ, AcTask.TUPLE, AcTask.tI} ∪
  (halvingClosure bound).image (fun k => AcTask.cnt AcTask.WRITE k) ∪
  (halvingClosure bound).image (fun k => AcTask.cntPar AcTask.MEM k) ∪
  (halvingClosure bound).image (fun k => AcTask.cntPar AcTask.TUPLE k)

section Membership

variable {vars : List F} {bound : ℕ}

@[simp] lemma SEL_mem_taskFinset (i : Fin 5) :
    (AcTask.SEL i : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset]

@[simp] lemma SELn_mem_taskFinset {n : ℕ} (hn : n ≤ vars.length) (i : Fin 5) :
    (AcTask.SELn n i : AcTask F A C) ∈ taskFinset vars bound := by
  simp only [taskFinset, Finset.mem_union, Finset.mem_image, Finset.mem_product,
    Finset.mem_range, Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, Prod.exists]
  simp
  omega

@[simp] lemma EQ_mem_taskFinset (i j : Fin 5) :
    (AcTask.EQ i j : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset]

@[simp] lemma EQn_mem_taskFinset {n : ℕ} (hn : n ≤ vars.length) (i j : Fin 5) :
    (AcTask.EQn n i j : AcTask F A C) ∈ taskFinset vars bound := by
  simp only [taskFinset, Finset.mem_union, Finset.mem_image, Finset.mem_product,
    Finset.mem_range, Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, Prod.exists]
  simp
  omega

@[simp] lemma STATE1_mem_taskFinset {n : ℕ} (hn : n ≤ vars.length) :
    (AcTask.STATE1 n : AcTask F A C) ∈ taskFinset vars bound := by
  simp only [taskFinset, Finset.mem_union, Finset.mem_image, Finset.mem_product,
    Finset.mem_range, Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, Prod.exists]
  simp
  omega

@[simp] lemma STATE3_mem_taskFinset {n : ℕ} (hn : n ≤ vars.length) :
    (AcTask.STATE3 n : AcTask F A C) ∈ taskFinset vars bound := by
  simp only [taskFinset, Finset.mem_union, Finset.mem_image, Finset.mem_product,
    Finset.mem_range, Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, Prod.exists]
  simp
  omega

@[simp] lemma MEM_mem_taskFinset : (AcTask.MEM : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset]

@[simp] lemma WRITE_mem_taskFinset : (AcTask.WRITE : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset]

@[simp] lemma READ_mem_taskFinset : (AcTask.READ : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset]

@[simp] lemma TUPLE_mem_taskFinset : (AcTask.TUPLE : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset]

@[simp] lemma tI_mem_taskFinset : (AcTask.tI : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset]

@[simp] lemma cnt_WRITE_mem_taskFinset {k : ℕ} (hk : k ∈ halvingClosure bound) :
    (AcTask.cnt AcTask.WRITE k : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset, hk]

@[simp] lemma cntPar_MEM_mem_taskFinset {k : ℕ} (hk : k ∈ halvingClosure bound) :
    (AcTask.cntPar AcTask.MEM k : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset, hk]

@[simp] lemma cntPar_TUPLE_mem_taskFinset {k : ℕ} (hk : k ∈ halvingClosure bound) :
    (AcTask.cntPar AcTask.TUPLE k : AcTask F A C) ∈ taskFinset vars bound := by
  simp [taskFinset, hk]

/-! The converse: what membership in `taskFinset` says about the parameters. -/

lemma le_of_SELn_mem_taskFinset {n : ℕ} {i : Fin 5}
    (h : (AcTask.SELn n i : AcTask F A C) ∈ taskFinset vars bound) : n ≤ vars.length := by
  simp [taskFinset] at h
  omega

lemma le_of_EQn_mem_taskFinset {n : ℕ} {i j : Fin 5}
    (h : (AcTask.EQn n i j : AcTask F A C) ∈ taskFinset vars bound) : n ≤ vars.length := by
  simp [taskFinset] at h
  omega

lemma le_of_STATE1_mem_taskFinset {n : ℕ}
    (h : (AcTask.STATE1 n : AcTask F A C) ∈ taskFinset vars bound) : n ≤ vars.length := by
  simp [taskFinset] at h
  omega

lemma le_of_STATE3_mem_taskFinset {n : ℕ}
    (h : (AcTask.STATE3 n : AcTask F A C) ∈ taskFinset vars bound) : n ≤ vars.length := by
  simp [taskFinset] at h
  omega

lemma of_cnt_mem_taskFinset {t : AcTask F A C} {k : ℕ}
    (h : AcTask.cnt t k ∈ taskFinset (F := F) (A := A) (C := C) vars bound) :
    t = AcTask.WRITE ∧ k ∈ halvingClosure bound := by
  simp [taskFinset] at h
  tauto

lemma of_cntPar_mem_taskFinset {t : AcTask F A C} {k : ℕ}
    (h : AcTask.cntPar t k ∈ taskFinset (F := F) (A := A) (C := C) vars bound) :
    (t = AcTask.MEM ∨ t = AcTask.TUPLE) ∧ k ∈ halvingClosure bound := by
  simp [taskFinset] at h
  tauto

end Membership

/-! ### The set of used tasks is closed under the method bodies -/

section Closure

variable {D : Domain F A C I} {vars : List F} {bound : ℕ}

/-- **No decomposition leaves `taskFinset`**: every compound task occurring in the body of a
method of a task of `taskFinset` is again in `taskFinset`.  Together with
`HTN.ToAc.tI_mem_taskFinset` this says that `taskFinset` contains every task reachable from the
initial task network of the compiled problem. -/
lemma mem_taskFinset_of_mem_bodies {t : AcTask F A C} (ht : t ∈ taskFinset vars bound)
    {ls : List (List (AcAct F A C ⊕ AcTask F A C))} (hls : ls ∈ bodies D vars bound t)
    {c : AcTask F A C} (hc : Sum.inr c ∈ ls.flatten) : c ∈ taskFinset vars bound := by
  have hchild : ∀ {k : ℕ}, k ∈ halvingClosure bound → 2 ≤ k →
      halvingChild k ∈ halvingClosure bound := fun hk hk2 =>
    halvingClosure_subset_of_mem hk (halvingChild_mem_halvingClosure hk2)
  cases t with
  | SEL i =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
        List.not_mem_nil, or_false, Sum.inr.injEq] at hc
      subst hc
      exact SELn_mem_taskFinset le_rfl _
  | SELn n i =>
      have hn := le_of_SELn_mem_taskFinset ht
      simp only [bodies] at hls
      split_ifs at hls with h0
      · simp only [Set.mem_singleton_iff] at hls; subst hls; simp at hc
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false, false_or, reduceCtorEq, Sum.inr.injEq] at hc
           subst hc
           exact SELn_mem_taskFinset (by omega) _)
  | EQ i j =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
        List.not_mem_nil, or_false, Sum.inr.injEq] at hc
      subst hc
      exact EQn_mem_taskFinset le_rfl _ _
  | EQn n i j =>
      have hn := le_of_EQn_mem_taskFinset ht
      simp only [bodies] at hls
      split_ifs at hls with h0
      · simp only [Set.mem_singleton_iff] at hls; subst hls; simp at hc
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false, false_or, reduceCtorEq, Sum.inr.injEq] at hc
           subst hc
           exact EQn_mem_taskFinset (by omega) _ _)
  | STATE1 n =>
      have hn := le_of_STATE1_mem_taskFinset ht
      simp only [bodies] at hls
      split_ifs at hls with hk
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
          List.not_mem_nil, or_false, Sum.inr.injEq] at hc
        subst hc
        exact STATE3_mem_taskFinset le_rfl
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false, false_or, reduceCtorEq, Sum.inr.injEq] at hc
           subst hc
           exact STATE1_mem_taskFinset (by omega))
  | STATE3 n =>
      have hn := le_of_STATE3_mem_taskFinset ht
      simp only [bodies] at hls
      split_ifs at hls with hk
      · obtain ⟨t', rfl⟩ := hls
        simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
          List.not_mem_nil, or_false, reduceCtorEq] at hc
      · obtain ⟨v, -, rfl | rfl⟩ := hls <;>
          (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false, false_or, reduceCtorEq, Sum.inr.injEq] at hc
           subst hc
           exact STATE3_mem_taskFinset (by omega))
  | MEM =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
        List.not_mem_nil, or_false, false_or, reduceCtorEq, Sum.inr.injEq] at hc
      subst hc
      exact STATE1_mem_taskFinset le_rfl
  | WRITE =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
        List.not_mem_nil, or_false, reduceCtorEq] at hc
  | READ =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
        List.not_mem_nil, or_false, reduceCtorEq] at hc
  | TUPLE =>
      rcases hls with ⟨c₀, x, y, -, rfl⟩ | ⟨o, rfl⟩ <;>
        (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
          List.not_mem_nil, or_false, false_or, reduceCtorEq, Sum.inr.injEq] at hc
         casesm* _ ∨ _
         all_goals subst_vars
         all_goals first
           | exact SEL_mem_taskFinset _
           | exact EQ_mem_taskFinset _ _
           | exact READ_mem_taskFinset
           | exact cnt_WRITE_mem_taskFinset (self_mem_halvingClosure _))
  | cnt t k =>
      obtain ⟨rfl, hk⟩ := of_cnt_mem_taskFinset ht
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he
      · subst hls; simp at hc
      · subst h1
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        rcases hls with rfl | rfl
        · simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false, Sum.inr.injEq] at hc
          subst hc
          exact WRITE_mem_taskFinset
        · simp at hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have h2 : 2 ≤ k := by omega
        have : halvingChild k = k / 2 := by simp [halvingChild, he]
        simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
          List.not_mem_nil, or_false, Sum.inr.injEq] at hc
        rcases hc with rfl | rfl <;>
          exact cnt_WRITE_mem_taskFinset (this ▸ hchild hk h2)
      · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        have h2 : 2 ≤ k := by omega
        have hchild' : halvingChild k = k - 1 := by simp [halvingChild, he]
        rcases hls with rfl | rfl <;>
          (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false, Sum.inr.injEq] at hc
           rcases hc with rfl | rfl
           all_goals first
             | exact WRITE_mem_taskFinset
             | exact cnt_WRITE_mem_taskFinset (hchild' ▸ hchild hk h2))
  | cntPar t k =>
      obtain ⟨htt, hk⟩ := of_cntPar_mem_taskFinset ht
      have hbase : t ∈ taskFinset (F := F) (A := A) (C := C) vars bound := by
        rcases htt with rfl | rfl
        · exact MEM_mem_taskFinset
        · exact TUPLE_mem_taskFinset
      have hcp : ∀ {j : ℕ}, j ∈ halvingClosure bound →
          AcTask.cntPar t j ∈ taskFinset (F := F) (A := A) (C := C) vars bound := by
        intro j hj
        rcases htt with rfl | rfl
        · exact cntPar_MEM_mem_taskFinset hj
        · exact cntPar_TUPLE_mem_taskFinset hj
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he
      · subst hls; simp at hc
      · subst h1
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        rcases hls with rfl | rfl
        · simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false, Sum.inr.injEq] at hc
          subst hc
          exact hbase
        · simp at hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have h2 : 2 ≤ k := by omega
        have hchild' : halvingChild k = k / 2 := by simp [halvingChild, he]
        simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.cons_append,
          List.nil_append, List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hc
        rcases hc with rfl | rfl <;>
          exact hcp (hchild' ▸ hchild hk h2)
      · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hls
        have h2 : 2 ≤ k := by omega
        have hchild' : halvingChild k = k - 1 := by simp [halvingChild, he]
        rcases hls with rfl | rfl <;>
          (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.cons_append,
            List.nil_append, List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hc
           casesm* _ ∨ _
           all_goals subst_vars
           all_goals first
             | exact hbase
             | exact hcp (hchild' ▸ hchild hk h2))
  | tI =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls
      simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.cons_append,
        List.nil_append, List.mem_cons, List.not_mem_nil, or_false, Sum.inr.injEq] at hc
      rcases hc with rfl | rfl
      · exact cntPar_MEM_mem_taskFinset (self_mem_halvingClosure _)
      · exact cntPar_TUPLE_mem_taskFinset (self_mem_halvingClosure _)

end Closure

/-! ### The method bodies as `Finset`s -/

section Bodies

variable (D : Domain F A C I) (ops : Finset A) (cs : Finset C) (vars : List F) (bound : ℕ)

/-- The triples `(c, x, y)` such that the source domain has a method `c ↦ x y`, restricted to
the given operators and compound task names. -/
noncomputable def seqPairFinset : Finset (C × (A ⊕ C) × (A ⊕ C)) :=
  (cs ×ˢ nameFinset ops cs ×ˢ nameFinset ops cs).filter
    (fun p => D.SeqBody p.1 [p.2.1, p.2.2])

lemma card_seqPairFinset_le : (seqPairFinset D ops cs).card ≤
    cs.card * ((nameFinset ops cs).card * (nameFinset ops cs).card) := by
  refine le_trans (Finset.card_filter_le _ _) ?_
  simp [Finset.card_product]

/-- The bodies of one compound task of the compiled domain, as a `Finset`.  This mirrors
`HTN.ToAc.bodies` exactly; the families indexed by the source signature are restricted to the
given operators and compound task names. -/
noncomputable def bodyFinset :
    AcTask F A C → Finset (List (List (AcAct F A C ⊕ AcTask F A C)))
  | .SEL i => {[[Sum.inr (.SELn vars.length i)]]}
  | .SELn n i =>
      if n = 0 then {[]}
      else
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.setV v i), Sum.inr (AcTask.SELn (n - 1) i)]]) ∪
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.delV v i), Sum.inr (AcTask.SELn (n - 1) i)]])
  | .EQ i j => {[[Sum.inr (.EQn vars.length i j)]]}
  | .EQn n i j =>
      if n = 0 then {[]}
      else
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.prePV v i j), Sum.inr (AcTask.EQn (n - 1) i j)]]) ∪
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.preNV v i j), Sum.inr (AcTask.EQn (n - 1) i j)]])
  | .STATE1 n =>
      if n = 0 then {[[Sum.inr (.STATE3 vars.length)]]}
      else
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.prePV v 0 0), Sum.inr (AcTask.STATE1 (n - 1)),
            Sum.inl (AcAct.setV v 3)]]) ∪
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.preNV v 0 0), Sum.inr (AcTask.STATE1 (n - 1)),
            Sum.inl (AcAct.delV v 3)]])
  | .STATE3 n =>
      if n = 0 then
        (nameFinset ops cs).image (fun t => [[Sum.inl (AcAct.preC t),
          Sum.inl (AcAct.doneA .write), Sum.inl (AcAct.accept .read), Sum.inl (AcAct.setC t)]])
      else
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.prePV v 2 2), Sum.inr (AcTask.STATE3 (n - 1)),
            Sum.inl (AcAct.setV v 4)]]) ∪
        (vars[n - 1]?).toFinset.image
          (fun v => [[Sum.inl (AcAct.preNV v 2 2), Sum.inr (AcTask.STATE3 (n - 1)),
            Sum.inl (AcAct.delV v 4)]])
  | .MEM => {[[Sum.inl (.accept .write), Sum.inr (.STATE1 vars.length),
      Sum.inl (.doneA .read)]]}
  | .WRITE => {[[Sum.inl (.ask .write), Sum.inl (.waitA .write)]]}
  | .READ => {[[Sum.inl (.ask .read), Sum.inl (.waitA .read)]]}
  | .TUPLE =>
      (seqPairFinset D ops cs).image (fun p =>
        [[Sum.inl .lock, Sum.inr (.SEL 0), Sum.inr (.SEL 1), Sum.inr (.SEL 2),
          Sum.inr .READ, Sum.inr (.EQ 0 3), Sum.inr (.EQ 1 4), Sum.inl (.preC p.2.1),
          Sum.inr .READ, Sum.inr (.EQ 1 3), Sum.inr (.EQ 2 4), Sum.inl (.preC p.2.2),
          Sum.inl (.setC (Sum.inr p.1)), Sum.inr (.cnt .WRITE bound), Sum.inl .unlock]]) ∪
      ops.image (fun o =>
        [[Sum.inl .lock, Sum.inr (.SEL 0), Sum.inr (.SEL 1), Sum.inr (.SEL 2),
          Sum.inr (.EQ 0 1), Sum.inl (.op2 o), Sum.inr (.EQ 1 2),
          Sum.inl (.setC (Sum.inl o)), Sum.inr (.cnt .WRITE bound), Sum.inl .unlock]])
  | .cnt t k =>
      if k = 0 then {[]}
      else if k = 1 then {[[Sum.inr t]], []}
      else if k % 2 = 0 then {[[Sum.inr (.cnt t (k / 2)), Sum.inr (.cnt t (k / 2))]]}
      else {[[Sum.inr t, Sum.inr (.cnt t (k - 1))]], [[Sum.inr (.cnt t (k - 1))]]}
  | .cntPar t k =>
      if k = 0 then {[]}
      else if k = 1 then {[[Sum.inr t]], []}
      else if k % 2 = 0 then
        {[[Sum.inr (.cntPar t (k / 2))], [Sum.inr (.cntPar t (k / 2))]]}
      else {[[Sum.inr t], [Sum.inr (.cntPar t (k - 1))]], [[Sum.inr (.cntPar t (k - 1))]]}
  | .tI => {[[Sum.inr (.cntPar .MEM bound)], [Sum.inr (.cntPar .TUPLE bound)]]}

variable {D ops cs vars bound}

/-- Every element of `HTN.ToAc.bodyFinset` really is a method body of the compiled domain. -/
lemma bodyFinset_subset_bodies (t : AcTask F A C) :
    ↑(bodyFinset D ops cs vars bound t) ⊆ bodies D vars bound t := by
  intro ls hls
  simp only [Finset.mem_coe] at hls
  cases t with
  | SEL i => simpa [bodyFinset, bodies] using hls
  | SELn n i =>
      simp only [bodyFinset, bodies] at hls ⊢
      split_ifs at hls ⊢ with hn
      · simpa using hls
      · simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset] at hls
        rcases hls with ⟨v, hv, rfl⟩ | ⟨v, hv, rfl⟩
        · exact ⟨v, hv, Or.inl rfl⟩
        · exact ⟨v, hv, Or.inr rfl⟩
  | EQ i j => simpa [bodyFinset, bodies] using hls
  | EQn n i j =>
      simp only [bodyFinset, bodies] at hls ⊢
      split_ifs at hls ⊢ with hn
      · simpa using hls
      · simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset] at hls
        rcases hls with ⟨v, hv, rfl⟩ | ⟨v, hv, rfl⟩
        · exact ⟨v, hv, Or.inl rfl⟩
        · exact ⟨v, hv, Or.inr rfl⟩
  | STATE1 n =>
      simp only [bodyFinset, bodies] at hls ⊢
      split_ifs at hls ⊢ with hn
      · simpa using hls
      · simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset] at hls
        rcases hls with ⟨v, hv, rfl⟩ | ⟨v, hv, rfl⟩
        · exact ⟨v, hv, Or.inl rfl⟩
        · exact ⟨v, hv, Or.inr rfl⟩
  | STATE3 n =>
      simp only [bodyFinset, bodies] at hls ⊢
      split_ifs at hls ⊢ with hn
      · simp only [Finset.mem_image] at hls
        obtain ⟨t', -, rfl⟩ := hls
        exact ⟨t', rfl⟩
      · simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset] at hls
        rcases hls with ⟨v, hv, rfl⟩ | ⟨v, hv, rfl⟩
        · exact ⟨v, hv, Or.inl rfl⟩
        · exact ⟨v, hv, Or.inr rfl⟩
  | MEM => simpa [bodyFinset, bodies] using hls
  | WRITE => simpa [bodyFinset, bodies] using hls
  | READ => simpa [bodyFinset, bodies] using hls
  | TUPLE =>
      simp only [bodyFinset, Finset.mem_union, Finset.mem_image] at hls
      rcases hls with ⟨p, hp, rfl⟩ | ⟨o, -, rfl⟩
      · simp only [seqPairFinset, Finset.mem_filter] at hp
        exact Or.inl ⟨p.1, p.2.1, p.2.2, hp.2, rfl⟩
      · exact Or.inr ⟨o, rfl⟩
  | cnt t k =>
      simp only [bodyFinset, bodies] at hls ⊢
      split_ifs at hls ⊢ <;> simpa using hls
  | cntPar t k =>
      simp only [bodyFinset, bodies] at hls ⊢
      split_ifs at hls ⊢ <;> simpa using hls
  | tI => simpa [bodyFinset, bodies] using hls

/-- If the source signature is covered by `ops` and `cs`, then `HTN.ToAc.bodyFinset` contains
*all* method bodies of the compiled domain: the `Finset` presentation is not an
under-approximation. -/
lemma bodies_subset_bodyFinset (hops : ∀ o : A, o ∈ ops) (hcs : ∀ c : C, c ∈ cs)
    (t : AcTask F A C) : bodies D vars bound t ⊆ ↑(bodyFinset D ops cs vars bound t) := by
  intro ls hls
  simp only [Finset.mem_coe]
  cases t with
  | SEL i => simpa [bodyFinset] using hls
  | SELn n i =>
      simp only [bodies] at hls
      simp only [bodyFinset]
      split_ifs at hls ⊢ with hn
      · simpa using hls
      · obtain ⟨v, hv, rfl | rfl⟩ := hls <;>
          (simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset]
           first
             | exact Or.inl ⟨v, hv, rfl⟩
             | exact Or.inr ⟨v, hv, rfl⟩)
  | EQ i j => simpa [bodyFinset] using hls
  | EQn n i j =>
      simp only [bodies] at hls
      simp only [bodyFinset]
      split_ifs at hls ⊢ with hn
      · simpa using hls
      · obtain ⟨v, hv, rfl | rfl⟩ := hls <;>
          (simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset]
           first
             | exact Or.inl ⟨v, hv, rfl⟩
             | exact Or.inr ⟨v, hv, rfl⟩)
  | STATE1 n =>
      simp only [bodies] at hls
      simp only [bodyFinset]
      split_ifs at hls ⊢ with hn
      · simpa using hls
      · obtain ⟨v, hv, rfl | rfl⟩ := hls <;>
          (simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset]
           first
             | exact Or.inl ⟨v, hv, rfl⟩
             | exact Or.inr ⟨v, hv, rfl⟩)
  | STATE3 n =>
      simp only [bodies] at hls
      simp only [bodyFinset]
      split_ifs at hls ⊢ with hn
      · obtain ⟨t', rfl⟩ := hls
        exact Finset.mem_image_of_mem _ (mem_nameFinset hops hcs)
      · obtain ⟨v, hv, rfl | rfl⟩ := hls <;>
          (simp only [Finset.mem_union, Finset.mem_image, Option.mem_toFinset]
           first
             | exact Or.inl ⟨v, hv, rfl⟩
             | exact Or.inr ⟨v, hv, rfl⟩)
  | MEM => simpa [bodyFinset] using hls
  | WRITE => simpa [bodyFinset] using hls
  | READ => simpa [bodyFinset] using hls
  | TUPLE =>
      rcases hls with ⟨c₀, x, y, hm, rfl⟩ | ⟨o, rfl⟩
      · have hmem : (c₀, x, y) ∈ seqPairFinset D ops cs := by
          simp only [seqPairFinset, Finset.mem_filter, Finset.mem_product]
          exact ⟨⟨hcs c₀, mem_nameFinset hops hcs, mem_nameFinset hops hcs⟩, hm⟩
        exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ hmem)
      · exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ (hops o))
  | cnt t k =>
      simp only [bodies] at hls
      simp only [bodyFinset]
      split_ifs at hls ⊢ <;> simpa using hls
  | cntPar t k =>
      simp only [bodies] at hls
      simp only [bodyFinset]
      split_ifs at hls ⊢ <;> simpa using hls
  | tI => simpa [bodyFinset] using hls

/-- Every compound task of the compiled domain has at most `B` bodies, where `B` counts the
methods `c ↦ x y` of the source domain, its operators and its task names. -/
lemma card_bodyFinset_le (t : AcTask F A C) :
    (bodyFinset D ops cs vars bound t).card ≤
      (nameFinset ops cs).card +
        cs.card * ((nameFinset ops cs).card * (nameFinset ops cs).card) + ops.card + 2 := by
  have hopt : ∀ (o : Option F) (f : F → List (List (AcAct F A C ⊕ AcTask F A C))),
      (o.toFinset.image f).card ≤ 1 := by
    intro o f
    refine le_trans Finset.card_image_le ?_
    cases o <;> simp
  have key : (bodyFinset D ops cs vars bound t).card ≤
      (nameFinset ops cs).card +
        cs.card * ((nameFinset ops cs).card * (nameFinset ops cs).card) + ops.card + 2 := by
    cases t with
    | SEL i => simp only [bodyFinset]; simp
    | SELn n i =>
        simp only [bodyFinset]
        split_ifs
        · simp
        · exact le_trans (Finset.card_union_le _ _)
            (by have := hopt (vars[n - 1]?) (fun v =>
              [[Sum.inl (AcAct.setV v i), Sum.inr (AcTask.SELn (n - 1) i)]])
                have := hopt (vars[n - 1]?) (fun v =>
                  [[Sum.inl (AcAct.delV v i), Sum.inr (AcTask.SELn (n - 1) i)]])
                omega)
    | EQ i j => simp only [bodyFinset]; simp
    | EQn n i j =>
        simp only [bodyFinset]
        split_ifs
        · simp
        · exact le_trans (Finset.card_union_le _ _)
            (by have := hopt (vars[n - 1]?) (fun v =>
              [[Sum.inl (AcAct.prePV v i j), Sum.inr (AcTask.EQn (n - 1) i j)]])
                have := hopt (vars[n - 1]?) (fun v =>
                  [[Sum.inl (AcAct.preNV v i j), Sum.inr (AcTask.EQn (n - 1) i j)]])
                omega)
    | STATE1 n =>
        simp only [bodyFinset]
        split_ifs
        · simp
        · exact le_trans (Finset.card_union_le _ _)
            (by have := hopt (vars[n - 1]?) (fun v =>
              [[Sum.inl (AcAct.prePV v 0 0), Sum.inr (AcTask.STATE1 (n - 1)),
                Sum.inl (AcAct.setV v 3)]])
                have := hopt (vars[n - 1]?) (fun v =>
                  [[Sum.inl (AcAct.preNV v 0 0), Sum.inr (AcTask.STATE1 (n - 1)),
                    Sum.inl (AcAct.delV v 3)]])
                omega)
    | STATE3 n =>
        simp only [bodyFinset]
        split_ifs
        · exact le_trans Finset.card_image_le (by omega)
        · exact le_trans (Finset.card_union_le _ _)
            (by have := hopt (vars[n - 1]?) (fun v =>
              [[Sum.inl (AcAct.prePV v 2 2), Sum.inr (AcTask.STATE3 (n - 1)),
                Sum.inl (AcAct.setV v 4)]])
                have := hopt (vars[n - 1]?) (fun v =>
                  [[Sum.inl (AcAct.preNV v 2 2), Sum.inr (AcTask.STATE3 (n - 1)),
                    Sum.inl (AcAct.delV v 4)]])
                omega)
    | MEM => simp only [bodyFinset]; simp
    | WRITE => simp only [bodyFinset]; simp
    | READ => simp only [bodyFinset]; simp
    | TUPLE =>
        simp only [bodyFinset]
        refine le_trans (Finset.card_union_le _ _)
          (le_trans (Nat.add_le_add Finset.card_image_le Finset.card_image_le) ?_)
        have h := card_seqPairFinset_le D ops cs
        omega
    | cnt t k =>
        simp only [bodyFinset]
        split_ifs <;> simp
    | cntPar t k =>
        simp only [bodyFinset]
        split_ifs <;> simp
    | tI => simp only [bodyFinset]; simp
  exact key

end Bodies

/-! ### The number of used tasks -/

/-- Auxiliary: cardinality bounds add along unions. -/
private lemma card_union_le_of_le {α : Type*} [DecidableEq α] {s t : Finset α} {m n : ℕ}
    (hs : s.card ≤ m) (ht : t.card ≤ n) : (s ∪ t).card ≤ m + n :=
  le_trans (Finset.card_union_le _ _) (Nat.add_le_add hs ht)

/-- **The construction uses at most `32·|vars| + 67 + 3·|halvingClosure bound|` compound
tasks.**  Since the halving closure of `k` has at most `2·log₂ k + 2` elements
(`HTN.card_halvingClosure_le`), this is linear in the number of facts of the source problem and
*logarithmic* in the (exponential) number of memory cells. -/
lemma card_taskFinset_le (vars : List F) (bound : ℕ) :
    (taskFinset (F := F) (A := A) (C := C) vars bound).card ≤
      32 * vars.length + 67 + 3 * (halvingClosure bound).card := by
  have hbase : ({AcTask.MEM, AcTask.WRITE, AcTask.READ, AcTask.TUPLE, AcTask.tI} :
      Finset (AcTask F A C)).card ≤ 5 := by
    have a1 := Finset.card_insert_le (AcTask.MEM : AcTask F A C)
      {AcTask.WRITE, AcTask.READ, AcTask.TUPLE, AcTask.tI}
    have a2 := Finset.card_insert_le (AcTask.WRITE : AcTask F A C)
      {AcTask.READ, AcTask.TUPLE, AcTask.tI}
    have a3 := Finset.card_insert_le (AcTask.READ : AcTask F A C) {AcTask.TUPLE, AcTask.tI}
    have a4 := Finset.card_insert_le (AcTask.TUPLE : AcTask F A C) {AcTask.tI}
    simp only [Finset.card_singleton] at a4
    omega
  have H : (taskFinset (F := F) (A := A) (C := C) vars bound).card ≤
      5 + (vars.length + 1) * 5 + 5 * 5 + (vars.length + 1) * (5 * 5) + (vars.length + 1) +
        (vars.length + 1) + 5 + (halvingClosure bound).card + (halvingClosure bound).card +
        (halvingClosure bound).card := by
    simp only [taskFinset]
    repeat refine card_union_le_of_le ?_ ?_
    · exact le_trans Finset.card_image_le (by simp)
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact le_trans Finset.card_image_le (by simp)
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact le_trans Finset.card_image_le (by simp)
    · exact le_trans Finset.card_image_le (by simp)
    · exact hbase
    · exact Finset.card_image_le
    · exact Finset.card_image_le
    · exact Finset.card_image_le
  omega

/-! ### The methods, the facts and the operators of the compiled domain -/

section Fragment

variable (D : Domain F A C I) (facts : Finset F) (ops : Finset A) (cs : Finset C)
  (vars : List F) (bound : ℕ)

/-- The methods of the compiled domain that the construction uses. -/
noncomputable def methodFinset :
    Finset (Method (ℕ × ℕ) (AcAct F A C) (AcTask F A C)) :=
  (taskFinset vars bound).biUnion fun t =>
    (bodyFinset D ops cs vars bound t).image fun ls => ⟨t, TaskNetwork.grid ls⟩

/-- The facts of the compiled signature. -/
noncomputable def factFinset : Finset (AcFact F A C) :=
  {AcFact.key0} ∪
  ({RW.read, RW.write} : Finset RW).image AcFact.key1 ∪
  ({RW.read, RW.write} : Finset RW).image AcFact.key2 ∪
  (facts ×ˢ (Finset.univ : Finset (Fin 5))).image (fun p => AcFact.pos p.1 p.2) ∪
  (facts ×ˢ (Finset.univ : Finset (Fin 5))).image (fun p => AcFact.neg p.1 p.2) ∪
  (nameFinset ops cs).image AcFact.task

/-- The operators of the compiled signature. -/
noncomputable def opFinset : Finset (AcAct F A C) :=
  (facts ×ˢ (Finset.univ : Finset (Fin 5))).image (fun p => AcAct.setV p.1 p.2) ∪
  (facts ×ˢ (Finset.univ : Finset (Fin 5))).image (fun p => AcAct.delV p.1 p.2) ∪
  (facts ×ˢ (Finset.univ : Finset (Fin 5)) ×ˢ (Finset.univ : Finset (Fin 5))).image
    (fun p => AcAct.prePV p.1 p.2.1 p.2.2) ∪
  (facts ×ˢ (Finset.univ : Finset (Fin 5)) ×ˢ (Finset.univ : Finset (Fin 5))).image
    (fun p => AcAct.preNV p.1 p.2.1 p.2.2) ∪
  (nameFinset ops cs).image AcAct.setC ∪
  (nameFinset ops cs).image AcAct.preC ∪
  ({AcAct.lock, AcAct.unlock} : Finset (AcAct F A C)) ∪
  ({RW.read, RW.write} : Finset RW).image AcAct.ask ∪
  ({RW.read, RW.write} : Finset RW).image AcAct.accept ∪
  ({RW.read, RW.write} : Finset RW).image AcAct.doneA ∪
  ({RW.read, RW.write} : Finset RW).image AcAct.waitA ∪
  ops.image AcAct.op2

/-- The fragment of the compiled signature that the construction uses. -/
noncomputable def fragment : Fragment (AcFact F A C) (AcAct F A C) (AcTask F A C) (ℕ × ℕ) where
  facts := factFinset facts ops cs
  ops := opFinset facts ops cs
  tasks := taskFinset vars bound
  methods := methodFinset D ops cs vars bound

variable {D ops cs vars bound}

/-- **The methods of the fragment really are methods of the compiled domain.** -/
lemma methodFinset_subset_methods :
    ↑(methodFinset D ops cs vars bound) ⊆ methods D vars bound := by
  intro m hm
  simp only [Finset.mem_coe, methodFinset, Finset.mem_biUnion, Finset.mem_image] at hm
  obtain ⟨t, -, ls, hls, rfl⟩ := hm
  exact ⟨ls, bodyFinset_subset_bodies t hls, rfl⟩

/-- **Conversely, if the source signature is covered, every method of the compiled domain whose
decomposed task is used belongs to the fragment.** -/
lemma mem_methodFinset_of_mem_methods (hops : ∀ o : A, o ∈ ops) (hcs : ∀ c : C, c ∈ cs)
    {m : Method (ℕ × ℕ) (AcAct F A C) (AcTask F A C)} (hm : m ∈ methods D vars bound)
    (ht : m.abstractTask ∈ taskFinset (F := F) (A := A) (C := C) vars bound) :
    m ∈ methodFinset D ops cs vars bound := by
  obtain ⟨ls, hls, hsub⟩ := hm
  refine Finset.mem_biUnion.2 ⟨m.abstractTask, ht, ?_⟩
  refine Finset.mem_image.2 ⟨ls, bodies_subset_bodyFinset hops hcs _ hls, ?_⟩
  cases m
  simpa using hsub.symm

/-- The number of methods used: at most one per (task, body) pair. -/
lemma card_methodFinset_le :
    (methodFinset D ops cs vars bound).card ≤
      (32 * vars.length + 67 + 3 * (halvingClosure bound).card) *
        ((ops.card + cs.card) + cs.card * ((ops.card + cs.card) * (ops.card + cs.card)) +
          ops.card + 2) := by
  set B := (ops.card + cs.card) + cs.card * ((ops.card + cs.card) * (ops.card + cs.card)) +
    ops.card + 2 with hB
  have hbody : ∀ t : AcTask F A C, (bodyFinset D ops cs vars bound t).card ≤ B := by
    intro t
    refine le_trans (card_bodyFinset_le t) ?_
    have hn := card_nameFinset_le ops cs
    have : cs.card * ((nameFinset ops cs).card * (nameFinset ops cs).card) ≤
        cs.card * ((ops.card + cs.card) * (ops.card + cs.card)) :=
      Nat.mul_le_mul_left _ (Nat.mul_le_mul hn hn)
    omega
  calc (methodFinset D ops cs vars bound).card
      ≤ ∑ t ∈ taskFinset (F := F) (A := A) (C := C) vars bound,
          ((bodyFinset D ops cs vars bound t).image
            (fun ls => (⟨t, TaskNetwork.grid ls⟩ : Method (ℕ × ℕ) (AcAct F A C)
              (AcTask F A C)))).card := Finset.card_biUnion_le
    _ ≤ ∑ _t ∈ taskFinset (F := F) (A := A) (C := C) vars bound, B :=
        Finset.sum_le_sum fun t _ => le_trans Finset.card_image_le (hbody t)
    _ = (taskFinset (F := F) (A := A) (C := C) vars bound).card * B := by
        rw [Finset.sum_const, smul_eq_mul]
    _ ≤ (32 * vars.length + 67 + 3 * (halvingClosure bound).card) * B :=
        Nat.mul_le_mul_right _ (card_taskFinset_le vars bound)

lemma card_factFinset_le :
    (factFinset (A := A) (C := C) facts ops cs).card ≤
      10 * facts.card + ops.card + cs.card + 5 := by
  have H : (factFinset (A := A) (C := C) facts ops cs).card ≤
      1 + 2 + 2 + facts.card * 5 + facts.card * 5 + (nameFinset ops cs).card := by
    simp only [factFinset]
    repeat refine card_union_le_of_le ?_ ?_
    · simp
    · exact le_trans Finset.card_image_le (le_trans (Finset.card_insert_le _ _) (by simp))
    · exact le_trans Finset.card_image_le (le_trans (Finset.card_insert_le _ _) (by simp))
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact Finset.card_image_le
  have hn := card_nameFinset_le ops cs
  omega

lemma card_opFinset_le :
    (opFinset (A := A) (C := C) facts ops cs).card ≤
      60 * facts.card + 2 * ops.card + 2 * cs.card + ops.card + 10 := by
  have hpair : ∀ a b : AcAct F A C, ({a, b} : Finset (AcAct F A C)).card ≤ 2 :=
    fun a b => le_trans (Finset.card_insert_le _ _) (by simp)
  have H : (opFinset (A := A) (C := C) facts ops cs).card ≤
      facts.card * 5 + facts.card * 5 + facts.card * (5 * 5) + facts.card * (5 * 5) +
        (nameFinset ops cs).card + (nameFinset ops cs).card + 2 + 2 + 2 + 2 + 2 + ops.card := by
    simp only [opFinset]
    repeat refine card_union_le_of_le ?_ ?_
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact le_trans Finset.card_image_le (by simp [Finset.card_product])
    · exact Finset.card_image_le
    · exact Finset.card_image_le
    · exact hpair _ _
    · exact le_trans Finset.card_image_le (le_trans (Finset.card_insert_le _ _) (by simp))
    · exact le_trans Finset.card_image_le (le_trans (Finset.card_insert_le _ _) (by simp))
    · exact le_trans Finset.card_image_le (le_trans (Finset.card_insert_le _ _) (by simp))
    · exact le_trans Finset.card_image_le (le_trans (Finset.card_insert_le _ _) (by simp))
    · exact Finset.card_image_le
  have hn := card_nameFinset_le ops cs
  omega

end Fragment

/-! ### A closed-form polynomial size bound -/

section Size

variable {F A C I : Type} [Fintype F] [Fintype A] [Fintype C]

omit [Fintype A] [Fintype C] in
private lemma ncard_le_card_F (s : Set F) : s.ncard ≤ Nat.card F := by
  rw [← Set.ncard_univ]
  exact Set.ncard_le_ncard (Set.subset_univ s) Set.finite_univ

omit [Fintype A] [Fintype C] in
private lemma ncard_image_le_card_F (s : Set F) (f : F → AcFact F A C) :
    (f '' s).ncard ≤ Nat.card F :=
  le_trans (Set.ncard_image_le (Set.toFinite s)) (ncard_le_card_F s)

omit [Fintype F] in
private lemma ncard_taskSet_le (t : A ⊕ C) :
    ({f : AcFact F A C | ∃ t', f = AcFact.task t' ∧ t' ≠ t}).ncard ≤
      Nat.card A + Nat.card C := by
  have h : {f : AcFact F A C | ∃ t', f = AcFact.task t' ∧ t' ≠ t}
      = AcFact.task '' {t' | t' ≠ t} := by
    ext f
    simp only [Set.mem_setOf_eq, Set.mem_image]
    constructor
    · rintro ⟨t', rfl, hne⟩; exact ⟨t', hne, rfl⟩
    · rintro ⟨t', hne, rfl⟩; exact ⟨t', rfl, hne⟩
  rw [h]
  refine le_trans (Set.ncard_image_le (Set.toFinite _)) ?_
  rw [← Nat.card_sum (α := A) (β := C), ← Set.ncard_univ]
  exact Set.ncard_le_ncard (Set.subset_univ _) Set.finite_univ

/-- **Every action of the compiled domain has size at most `5|V| + |O| + |C| + 3`.** -/
lemma actionSize_le (D : Domain F A C I) (vars : List F) (bound : ℕ) (a : AcAct F A C) :
    (domain D vars bound).actionSize a ≤ 5 * Nat.card F + Nat.card A + Nat.card C + 3 := by
  have hpair : ∀ (x y : AcFact F A C), ({x, y} : Set (AcFact F A C)).ncard ≤ 2 := by
    intro x y
    refine le_trans (Set.ncard_insert_le _ _) ?_
    simp
  simp only [ActionModel.actionSize, domain, actionModel]
  cases a with
  | setV v i => simp [prec, add, del]
  | delV v i => simp [prec, add, del]
  | prePV v i j =>
      simp only [prec, add, del, Set.ncard_empty]
      have := hpair (AcFact.pos v i) (AcFact.pos v j)
      omega
  | preNV v i j =>
      simp only [prec, add, del, Set.ncard_empty]
      have := hpair (AcFact.neg v i) (AcFact.neg v j)
      omega
  | setC t =>
      simp only [prec, add, del, Set.ncard_empty, Set.ncard_singleton]
      have := ncard_taskSet_le (F := F) t
      omega
  | preC t => simp [prec, add, del]
  | lock => simp [prec, add, del]
  | unlock => simp [prec, add, del]
  | ask x => simp [prec, add, del]
  | accept x => simp [prec, add, del]
  | doneA x => simp [prec, add, del]
  | waitA x => simp [prec, add, del]
  | op2 o =>
      simp only [prec, add, del]
      have h1 := ncard_image_le_card_F (A := A) (C := C) (D.prec o) (fun v => AcFact.pos v 1)
      have h2 := ncard_image_le_card_F (A := A) (C := C) (D.add o) (fun v => AcFact.pos v 1)
      have h3 := ncard_image_le_card_F (A := A) (C := C) (D.del o) (fun v => AcFact.neg v 1)
      have h4 := ncard_image_le_card_F (A := A) (C := C) (D.add o) (fun v => AcFact.neg v 1)
      have h5 := ncard_image_le_card_F (A := A) (C := C) (D.del o) (fun v => AcFact.pos v 1)
      have hu1 := Set.ncard_union_le ((fun v => AcFact.pos v 1) '' D.add o)
        ((fun v => (AcFact.neg v 1 : AcFact F A C)) '' D.del o)
      have hu2 := Set.ncard_union_le ((fun v => AcFact.neg v 1) '' D.add o)
        ((fun v => (AcFact.pos v 1 : AcFact F A C)) '' D.del o)
      omega

/-- The fragment of the compiled signature for the whole (finite) source signature. -/
noncomputable def fullFragment (D : Domain F A C I) (vars : List F) (bound : ℕ) :
    Fragment (AcFact F A C) (AcAct F A C) (AcTask F A C) (ℕ × ℕ) :=
  fragment D Finset.univ Finset.univ Finset.univ vars bound

/-- The closed-form size bound of the HTN-AC compilation: a polynomial in the number `nf` of
facts, `no` of operators and `nc` of compound tasks of the source problem, in the length `nv`
of the list of facts used by the construction, and in the number `L` of counting tasks (which
is logarithmic in the number of memory cells). -/
def sizeBound (nf no nc nv L : ℕ) : ℕ :=
  (10 * nf + no + nc + 5) + (32 * nv + 67 + 3 * L) +
    (60 * nf + 3 * no + 2 * nc + 10) * (5 * nf + no + nc + 3) +
    931 * ((32 * nv + 67 + 3 * L) * (no + nc + nc * ((no + nc) * (no + nc)) + no + 2))

/-- **Closed-form polynomial size bound for the HTN-AC compilation.**  The size of the compiled
domain, measured on the part of its signature that the construction uses, is bounded by
`HTN.ToAc.sizeBound` applied to the size of the source signature, the length of the list of
facts and the number of counting tasks — and the latter is logarithmic in the (exponentially
large) number `bound` of memory cells, by `HTN.card_halvingClosure_le`. -/
theorem sizeOn_fullFragment_le (D : Domain F A C I) (vars : List F) (bound : ℕ) :
    (domain D vars bound).sizeOn (fullFragment D vars bound) ≤
      sizeBound (Nat.card F) (Nat.card A) (Nat.card C) vars.length
        (halvingClosure bound).card := by
  have hcardF : (Finset.univ : Finset F).card = Nat.card F := by
    simp [Nat.card_eq_fintype_card]
  have hcardA : (Finset.univ : Finset A).card = Nat.card A := by
    simp [Nat.card_eq_fintype_card]
  have hcardC : (Finset.univ : Finset C).card = Nat.card C := by
    simp [Nat.card_eq_fintype_card]
  have hfacts : (factFinset (F := F) (A := A) (C := C) Finset.univ Finset.univ
      Finset.univ).card ≤ 10 * Nat.card F + Nat.card A + Nat.card C + 5 := by
    have := card_factFinset_le (F := F) (facts := (Finset.univ : Finset F))
      (ops := (Finset.univ : Finset A)) (cs := (Finset.univ : Finset C))
    rwa [hcardF, hcardA, hcardC] at this
  have htasks : (taskFinset (F := F) (A := A) (C := C) vars bound).card ≤
      32 * vars.length + 67 + 3 * (halvingClosure bound).card := card_taskFinset_le vars bound
  have hops : (opFinset (F := F) (A := A) (C := C) Finset.univ Finset.univ Finset.univ).card ≤
      60 * Nat.card F + 3 * Nat.card A + 2 * Nat.card C + 10 := by
    have := card_opFinset_le (F := F) (facts := (Finset.univ : Finset F))
      (ops := (Finset.univ : Finset A)) (cs := (Finset.univ : Finset C))
    rw [hcardF, hcardA, hcardC] at this
    omega
  have hmeth : (methodFinset D Finset.univ Finset.univ vars bound).card ≤
      (32 * vars.length + 67 + 3 * (halvingClosure bound).card) *
        (Nat.card A + Nat.card C + Nat.card C *
          ((Nat.card A + Nat.card C) * (Nat.card A + Nat.card C)) + Nat.card A + 2) := by
    have := card_methodFinset_le (D := D) (ops := (Finset.univ : Finset A))
      (cs := (Finset.univ : Finset C)) (vars := vars) (bound := bound)
    rwa [hcardA, hcardC] at this
  -- the sum of the action sizes
  have hsumops : ∑ a ∈ opFinset (F := F) (A := A) (C := C) Finset.univ Finset.univ Finset.univ,
      (domain D vars bound).actionSize a ≤
      (60 * Nat.card F + 3 * Nat.card A + 2 * Nat.card C + 10) *
        (5 * Nat.card F + Nat.card A + Nat.card C + 3) := by
    refine le_trans (Finset.sum_le_card_nsmul _ _ _
      (fun a _ => actionSize_le D vars bound a)) ?_
    rw [smul_eq_mul]
    exact Nat.mul_le_mul_right _ hops
  -- the sum of the method sizes
  have hsummeth : ∑ m ∈ methodFinset D Finset.univ Finset.univ vars bound, m.size ≤
      931 * ((32 * vars.length + 67 + 3 * (halvingClosure bound).card) *
        (Nat.card A + Nat.card C + Nat.card C *
          ((Nat.card A + Nat.card C) * (Nat.card A + Nat.card C)) + Nat.card A + 2)) := by
    refine le_trans (Finset.sum_le_card_nsmul _ _ 931 (fun m hm => method_size_le
      (methodFinset_subset_methods (Finset.mem_coe.2 hm)))) ?_
    rw [smul_eq_mul, Nat.mul_comm]
    exact Nat.mul_le_mul_left _ hmeth
  simp only [Domain.sizeOn, fullFragment, fragment, sizeBound]
  exact Nat.add_le_add (Nat.add_le_add (Nat.add_le_add hfacts htasks) hsumops) hsummeth

/-- The same bound with the number of counting tasks replaced by its logarithmic estimate. -/
theorem sizeOn_fullFragment_le_log (D : Domain F A C I) (vars : List F) (bound : ℕ) :
    (domain D vars bound).sizeOn (fullFragment D vars bound) ≤
      sizeBound (Nat.card F) (Nat.card A) (Nat.card C) vars.length
        (2 * Nat.log 2 bound + 2) := by
  refine le_trans (sizeOn_fullFragment_le D vars bound) ?_
  have hL := card_halvingClosure_le bound
  unfold sizeBound
  have h1 : 32 * vars.length + 67 + 3 * (halvingClosure bound).card ≤
      32 * vars.length + 67 + 3 * (2 * Nat.log 2 bound + 2) := by omega
  exact Nat.add_le_add (Nat.add_le_add (Nat.add_le_add le_rfl h1) le_rfl)
    (Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ h1))

end Size

