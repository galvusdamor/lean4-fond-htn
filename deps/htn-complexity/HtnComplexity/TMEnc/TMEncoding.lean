import HtnPlanning.Core.Construction
import ComplexityTheory.TM.Theory.Machine
/-!
# Encoding exponential-time Turing machines into acyclic, totally ordered HTN problems

This file formalises the *translation* of Theorem 4.3.7 of

  P. Bercher, G. Behnke, D. Höller, T. Geier, R. Alford,
  *Propositional Hierarchical Task Network Planning: Problem Classes and Complexity Results*
  (`HTN-Complextiy--mainfile.pdf`, pp. 72–88),

which is the corrected version of Theorem 6.1 of Alford, Bercher and Aha, *Tight Bounds for HTN
Planning* (ICAPS 2015).  Given a nondeterministic Turing machine `N` (see
`ComplexityTheory/TM/Theory/Machine.lean`), an input word `w` and a time bound `K` (which for the
hardness result is `K = 2 ^ p(|w|)`, i.e. exponential), the translation produces an HTN
planning problem whose solutions are exactly the accepting runs of `N` on `w`, written out as
the witness `W = #w₀#w₁#…#w_K`.

## The construction

*Facts* (`HTN.TMEnc.TMFact`): one fact per tape symbol (`sym c`, where `none` is the separator
`#`), one fact per machine state (`st q`), the two complementary facts `head`/`noHead` and, for
each of the three synchronisation channels `head`, `check`, `sync` (`HTN.TMEnc.SyncKind`), the
semaphore facts `stepF x` and `steppedF x`.

*Actions* (`HTN.TMEnc.TMAct`): exactly Table 4.3.1 of the source — `assert c`, `check f`,
`call x`, `start x`, `respond x`, `wait x`, `assertHead`, `retractHead` and the transition
actions `step`.

*Compound tasks* (`HTN.TMEnc.TMTask`) and *methods* (`HTN.TMEnc.bodies`): the tasks
`acquire x`, `release x`, `produce`, `produceSym c`, `tapeProduce`, `waitCell` (the source's
`wait`), `waitN i` (`wait^i`), `chk` (the source's `check`), `headCell`, `noHeadCell`, `heads`,
`transition`, `transitionAndCheck`, `checkers i`, `produceInit`, `produceWord i`, `done`, the
counting tasks `cSeq t k`, `cPar t k` (the source's `C^k_t` and `C_k^t`) and the fresh initial
task `sI` that makes the initial task network totally ordered.

A method body is given as a list of *parallel chains* of task names — the brace notation of the
source, see `HTN.TaskNetwork.grid` — so `(a, b, c)` is `[[a, b, c]]` and `{(a, b), (c)}` is
`[[a, b], [c]]`.

## What is proved here

* `HTN.TMEnc.wf` — the constructed problem is a well-formed HTN planning problem;
* `HTN.TMEnc.isTO_tnI` — its initial task network is totally ordered (this is the point of the
  extra task `sI`);
* `HTN.TMEnc.isAcyclic` — it is **acyclic**, via the explicit rank function
  `HTN.TMEnc.rank`; hence the constructed problems lie in `TO-tn_I ∩ ACYC`, which is the
  structural claim of Theorem 4.3.7;
* `HTN.TMEnc.method_card_le`, `HTN.TMEnc.method_size_le` — every method of the domain has at
  most `9` subtasks and size at most `91`, i.e. a bound *independent of the (exponential) time
  bound `K`*: the exponentially many tasks are generated by the logarithmically many counting
  methods `cSeq`/`cPar`, not written down;
* `HTN.TMEnc.card_halvingClosure_le` — the corresponding logarithmic bound for the counting
  gadget: the counting task `C^k` refers only to the `≤ 2·log₂ k + 2` counting tasks of the
  *halving closure* of `k`.

Following the instructions for this project, the statement that the translation is computable
in polynomial *time* is not formalised; the *size* bounds above are.  The simulation
correctness of the translation (a solution of the constructed problem is a witness of an
accepting run of `N`, and conversely) is not proved here — it is carried as an explicit
hypothesis in `HtnCompilability/TMEnc/NonCompilability.lean`; see `NOTES.md`.
-/

namespace HTN

namespace TMEnc

open TM

/-! ### Facts, actions and compound tasks -/

/-- The three synchronisation channels of the construction: the head counter, and the two
phases `check` and `sync` of the tape cell counters. -/
inductive SyncKind
  /-- Synchronisation with the head counter. -/
  | head
  /-- First synchronisation phase of the cell counters. -/
  | check
  /-- Second synchronisation phase of the cell counters. -/
  | sync
  deriving DecidableEq, Repr, Inhabited

/-- The facts of the encoding. -/
inductive TMFact (Q Γ : Type)
  /-- The current tape cell contains the symbol `c` (`none` is the separator `#`). -/
  | sym (c : Option Γ)
  /-- The machine is in state `q`. -/
  | st (q : Q)
  /-- The head is at the current cell. -/
  | head
  /-- The head is not at the current cell. -/
  | noHead
  /-- The semaphore fact `x_step`. -/
  | stepF (x : SyncKind)
  /-- The semaphore fact `x_stepped`. -/
  | steppedF (x : SyncKind)
  deriving DecidableEq

/-- The actions of the encoding — Table 4.3.1 of the source. -/
inductive TMAct (Q Γ : Type)
  /-- `assert_c`: write the symbol `c` into the current cell. -/
  | assert (c : Option Γ)
  /-- `check_f`: test the fact `f` (used for tape symbols, for `noHead` and for states). -/
  | check (f : TMFact Q Γ)
  /-- `call_x`. -/
  | call (x : SyncKind)
  /-- `start_x`. -/
  | start (x : SyncKind)
  /-- `respond_x`. -/
  | respond (x : SyncKind)
  /-- `wait_x`. -/
  | wait (x : SyncKind)
  /-- `assert_head`. -/
  | assertHead
  /-- `retract_head`. -/
  | retractHead
  /-- `step^{q,c}_{q',c'}`: apply a transition of the machine. -/
  | step (q : Q) (c : Option Γ) (q' : Q) (c' : Option Γ)
  deriving DecidableEq, Inhabited

/-- The compound tasks of the encoding. -/
inductive TMTask (Q Γ : Type)
  /-- `acquire_x`. -/
  | acquire (x : SyncKind)
  /-- `release_x`. -/
  | release (x : SyncKind)
  /-- `produce`: one tape cell with an arbitrary symbol. -/
  | produce
  /-- `produce_c`: one tape cell containing the symbol `c`. -/
  | produceSym (c : Option Γ)
  /-- `tapeProduce`: one full tape `#wᵢ`. -/
  | tapeProduce
  /-- `wait`: one waiting cycle of a cell counter. -/
  | waitCell
  /-- `wait^i`: `i` waiting cycles. -/
  | waitN (i : ℕ)
  /-- `check`: one checking cycle of a cell counter. -/
  | chk
  /-- `head`: a cell of the head counter at which the head is present. -/
  | headCell
  /-- `noHead`: a cell of the head counter at which the head is absent. -/
  | noHeadCell
  /-- `heads`: a full cycle of the head counter. -/
  | heads
  /-- `transition`: one transition of the machine. -/
  | transition
  /-- `transitionAndCheck`. -/
  | transitionAndCheck
  /-- `checkers^i`: start `i` cell counters. -/
  | checkers (i : ℕ)
  /-- `produce_init`: the initial tape. -/
  | produceInit
  /-- `produce_{w^i}`: the suffix of the input starting at position `i`. -/
  | produceWord (i : ℕ)
  /-- `done`: the machine has stopped in an accepting state. -/
  | done
  /-- `C^k_t`: `k` totally ordered copies of `t`. -/
  | cSeq (t : TMTask Q Γ) (k : ℕ)
  /-- `C_k^t`: `k` unordered copies of `t`. -/
  | cPar (t : TMTask Q Γ) (k : ℕ)
  /-- The fresh initial compound task making the initial task network totally ordered. -/
  | sI
  deriving DecidableEq, Inhabited

/-! ### The action model (Table 4.3.1) -/

variable {Q Γ : Type}

/-- Preconditions of the actions (Table 4.3.1). -/
def prec : TMAct Q Γ → Set (TMFact Q Γ)
  | .assert _ => ∅
  | .check f => {f}
  | .call _ => ∅
  | .start x => {.stepF x}
  | .respond _ => ∅
  | .wait x => {.steppedF x}
  | .assertHead => ∅
  | .retractHead => ∅
  | .step q c _ _ => {.head, .sym c, .st q}

/-- Add effects of the actions (Table 4.3.1). -/
def add : TMAct Q Γ → Set (TMFact Q Γ)
  | .assert c => {.sym c}
  | .check _ => ∅
  | .call x => {.stepF x}
  | .start _ => ∅
  | .respond x => {.steppedF x}
  | .wait _ => ∅
  | .assertHead => {.head}
  | .retractHead => {.noHead}
  | .step _ _ q' c' => {.sym c', .st q'}

/-- Delete effects of the actions (Table 4.3.1). -/
def del : TMAct Q Γ → Set (TMFact Q Γ)
  | .assert c => {f | ∃ d, f = TMFact.sym d ∧ d ≠ c}
  | .check _ => ∅
  | .call _ => ∅
  | .start x => {.stepF x}
  | .respond _ => ∅
  | .wait x => {.steppedF x}
  | .assertHead => {.noHead}
  | .retractHead => {.head}
  | .step q c _ _ => {.sym c, .st q}

/-- The action model of the encoding. -/
def actionModel : ActionModel (TMFact Q Γ) (TMAct Q Γ) where
  prec := prec
  add := add
  del := del

/-! ### The methods

A method body is a list of parallel chains of task names; `HTN.TaskNetwork.grid` turns it into
a task network. -/

/-- The number of additional `acquire_head` tasks that "eat up" steps of the head counter: none
if the head moves right, one if it stays, two if it moves left. -/
def moveExtra : Move → ℕ
  | .right => 0
  | .stay => 1
  | .left => 2

section Bodies

variable (N : NTM Q Γ) (w : List Γ) (K : ℕ)

/-- The method bodies of the encoding, task by task; a body is a list of parallel chains (the
brace notation of the source).  The initial task `sI` is treated separately, see
`HTN.TMEnc.initNet`. -/
def bodies : TMTask Q Γ → Set (List (List (TMAct Q Γ ⊕ TMTask Q Γ)))
  | .acquire x => {[[Sum.inl (.call x), Sum.inl (.wait x)]]}
  | .release x => {[[Sum.inl (.start x), Sum.inl (.respond x)]]}
  | .produce => {ls | ∃ c : Option Γ, ls =
      [[Sum.inl (.assert c), Sum.inr (.acquire .head),
        Sum.inr (.cSeq (.acquire .check) (K + 1)), Sum.inr (.cSeq (.acquire .sync) (K + 1))]]}
  | .produceSym c => {[[Sum.inl (.assert c), Sum.inr (.acquire .head),
      Sum.inr (.cSeq (.acquire .check) (K + 1)), Sum.inr (.cSeq (.acquire .sync) (K + 1))]]}
  | .tapeProduce => {[[Sum.inr (.produceSym none), Sum.inr (.cSeq .produce K)]]}
  | .waitCell => {[[Sum.inr (.release .check), Sum.inr (.release .sync)]]}
  | .waitN i => {[[Sum.inr (.cSeq .waitCell i)]]}
  | .chk => {ls | ∃ c : Option Γ, ls =
      [[Sum.inl (.check (.sym c)), Sum.inr (.release .sync), Sum.inr (.waitN K),
        Sum.inr (.release .check), Sum.inl (.check (.sym c))]]}
  | .headCell => {[[Sum.inl (.start .head), Sum.inl .assertHead, Sum.inl (.respond .head)]]}
  | .noHeadCell => {[[Sum.inl (.start .head), Sum.inl .retractHead, Sum.inl (.respond .head)]]}
  -- The source prints `heads → (noHead, head, C^{K+2}_noHead)` here.  That constant cannot be
  -- right: one cycle of the head counter has to emit exactly as many answers as one tape
  -- consumes, which is `K + 2` (the `K + 1` symbols of the tape plus the one step that the
  -- transition of that tape "eats up"), while `C^{K+2}` makes the cycle `K + 4` long.  The
  -- initial task network of the source — `retract_head, respond_head, head, C^K_noHead, …` —
  -- is aligned with the corrected value, and so is the discussion of the head movement ("we
  -- may have to count either `K`, `K + 1` or `K + 2` cells").  See `NOTES.md` for the full
  -- counting argument; `HTN.TMEnc.countP_start_head_eq` is its formal half.
  | .heads => {[[Sum.inr .noHeadCell, Sum.inr .headCell, Sum.inr (.cSeq .noHeadCell K)]]}
  | .transition => {ls | ∃ (q q' : Q) (c c' : Γ) (m : Move), (q', c', m) ∈ N.step q c ∧
      ls = [Sum.inl (.step q (some c) q' (some c')) ::
        List.replicate (moveExtra m) (Sum.inr (.acquire .head))]}
  | .transitionAndCheck => {[[Sum.inr .transition, Sum.inr .chk]],
      [[Sum.inl (.check .noHead), Sum.inr .chk]]}
  | .checkers i =>
      if i = 0 then {[]}
      else if i = 1 then {[[Sum.inr (.release .check), Sum.inr .chk,
        Sum.inr (.cSeq .transitionAndCheck K), Sum.inr (.release .sync)]]}
      -- The two recursive rules use the *unordered* counting task `C_k^t` (`cPar`, the source's
      -- unbarred `C`), not the totally ordered one: a whole group of `i/2` counters is delayed
      -- by `i/2` cells by putting `i/2` **parallel** chains of `i/2` waits in front of it — one
      -- for each counter of the group, since every one of the `K + 1` counters has to answer
      -- one synchronisation request at every single tape cell, also while it is being delayed.
      else if i % 2 = 0 then
        {[[Sum.inr (.cPar (.waitN (i / 2)) (i / 2)), Sum.inr (.checkers (i / 2))],
          [Sum.inr (.checkers (i / 2)), Sum.inr (.cPar (.waitN (i / 2)) (i / 2))]]}
      else
        {[[Sum.inr (.cPar (.waitN 1) (i - 1)), Sum.inr (.checkers (i - 1))],
          [Sum.inr (.checkers 1), Sum.inr (.waitN (i - 1))]]}
  | .produceInit => {[[Sum.inr (.produceSym none), Sum.inr (.produceWord 0),
      Sum.inr (.cSeq (.produceSym (some N.blank)) (K - w.length))]]}
  | .produceWord i =>
      if i + 1 < w.length then
        {[[Sum.inr (.produceSym (some (w.getD i N.blank))), Sum.inr (.produceWord (i + 1))]]}
      else {[[Sum.inr (.produceSym (some (w.getD i N.blank)))]]}
  | .done => {ls | ∃ f ∈ N.accept, ls = [[Sum.inl (.check (.st f))]]}
  | .cSeq t k =>
      if k = 0 then {[]}
      else if k = 1 then {[[Sum.inr t]]}
      else if k % 2 = 0 then {[[Sum.inr (.cSeq t (k / 2)), Sum.inr (.cSeq t (k / 2))]]}
      else {[[Sum.inr t, Sum.inr (.cSeq t (k - 1))]]}
  | .cPar t k =>
      if k = 0 then {[]}
      else if k = 1 then {[[Sum.inr t]]}
      else if k % 2 = 0 then {[[Sum.inr (.cPar t (k / 2))], [Sum.inr (.cPar t (k / 2))]]}
      else {[[Sum.inr t], [Sum.inr (.cPar t (k - 1))]]}
  | .sI => ∅

/-- The three parallel chains of the initial task network of the source (the head counter, the
`K+1` cell counters and the production of the tape). -/
def initChains : List (List (TMAct Q Γ ⊕ TMTask Q Γ)) :=
  [[Sum.inl .retractHead, Sum.inl (.respond .head), Sum.inr .headCell,
    Sum.inr (.cSeq .noHeadCell K), Sum.inr (.cSeq .heads K)],
   [Sum.inr (.checkers (K + 1))],
   [Sum.inr .produceInit, Sum.inr (.cSeq .tapeProduce K)]]

/-- The task network that the source uses as its initial task network: the three parallel
chains of `HTN.TMEnc.initChains`, all ordered before the task `done`.  In our construction it
is the subtask network of the unique method for the fresh initial task `sI`. -/
def initNet : TaskNetwork (ℕ × ℕ) (TMAct Q Γ) (TMTask Q Γ) :=
  TaskNetwork.gridTail (initChains K) [Sum.inr .done]

end Bodies

/-! ### The encoded domain and problem -/

section Encoding

variable (N : NTM Q Γ) (w : List Γ) (K : ℕ)

/-- The methods of the encoded domain: one method per body of `HTN.TMEnc.bodies`, plus the
single method of the fresh initial task `sI`. -/
def methods : Set (Method (ℕ × ℕ) (TMAct Q Γ) (TMTask Q Γ)) :=
  {m | ∃ ls ∈ bodies N w K m.abstractTask, m.subtasks = TaskNetwork.grid ls} ∪
    {⟨.sI, initNet K⟩}

/-- The encoded HTN planning domain. -/
def domain : Domain (TMFact Q Γ) (TMAct Q Γ) (TMTask Q Γ) (ℕ × ℕ) where
  toActionModel := actionModel
  methods := methods N w K

/-- The encoded HTN planning problem instance: initially only the initial state of the machine
holds, the goal is empty (acceptance is enforced by the hierarchy), and the initial task
network is the single task `sI`. -/
def instance_ : Instance (TMFact Q Γ) (TMAct Q Γ) (TMTask Q Γ) (ℕ × ℕ) where
  init := {TMFact.st N.init}
  goal := ∅
  tnI := TaskNetwork.seq [Sum.inr .sI]

/-- The encoded HTN planning problem. -/
def problem : Problem (TMFact Q Γ) (TMAct Q Γ) (TMTask Q Γ) (ℕ × ℕ) :=
  (domain N w K).mkProblem (instance_ N)

end Encoding

/-! ### Well-formedness and total orderedness of the initial task network -/

section Structure

variable (N : NTM Q Γ) (w : List Γ) (K : ℕ)

lemma methods_wf : ∀ m ∈ methods N w K, m.subtasks.WF := by
  rintro ⟨c, tn⟩ (⟨ls, -, rfl⟩ | hm)
  · exact TaskNetwork.grid_wf
  · simp only [Set.mem_singleton_iff, Method.mk.injEq] at hm
    obtain ⟨rfl, rfl⟩ := hm
    exact TaskNetwork.gridTail_wf

/-- **The encoded problem is well formed.** -/
theorem wf : (problem N w K).WF where
  tnI := TaskNetwork.seq_wf
  methods := methods_wf N w K

/-- **The initial task network of the encoded problem is totally ordered** — this is the point
of the fresh initial task `sI`. -/
theorem isTO_tnI : (problem N w K).IsTO_tnI := TaskNetwork.seq_isTotallyOrdered

end Structure

/-! ### Acyclicity -/

/-- The rank of a compound task: a natural number that strictly decreases along every method of
the encoding, witnessing that the constructed domain is acyclic.  `K` is the time bound and `n`
the length of the input word. -/
def rank (K n : ℕ) : TMTask Q Γ → ℕ
  | .acquire _ => 0
  | .release _ => 0
  | .produce => K + 3
  | .produceSym _ => K + 3
  | .tapeProduce => 2 * K + 5
  | .waitCell => 1
  | .waitN i => i + 3
  | .chk => K + 4
  | .headCell => 0
  | .noHeadCell => 0
  | .heads => K + 4
  | .transition => 1
  | .transitionAndCheck => K + 5
  | .checkers i => 2 * K + 7 + 3 * i
  | .produceInit => 2 * K + n + 6
  | .produceWord i => K + 4 + (n - i)
  | .done => 0
  | .cSeq t k => rank K n t + 1 + k
  | .cPar t k => rank K n t + 1 + k
  | .sI => 10 * (K + n) + 100

section Acyclic

variable {N : NTM Q Γ} {w : List Γ} {K : ℕ}
/-- Reduce a membership `Sum.inr c ∈ (explicit list of chains).flatten` to the finitely many
possibilities for `c` and close the resulting rank inequalities. -/
local macro "flatten_rank" h:ident : tactic =>
  `(tactic| (simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.cons_append,
      List.nil_append, List.mem_cons, List.mem_append, List.not_mem_nil, List.mem_replicate,
      or_false, false_or, reduceCtorEq, Sum.inr.injEq, Sum.inl.injEq] at $h:ident <;>
      (try casesm* _ ∧ _, _ ∨ _) <;> subst_vars <;> simp only [rank] <;> omega))

/-- Every compound task occurring in a method body has a strictly smaller rank than the task
that the method decomposes. -/
lemma rank_lt_of_mem_bodies {t : TMTask Q Γ} {ls : List (List (TMAct Q Γ ⊕ TMTask Q Γ))}
    (hls : ls ∈ bodies N w K t) {c : TMTask Q Γ} (hc : Sum.inr c ∈ ls.flatten) :
    rank K w.length c < rank K w.length t := by
  cases t with
  | acquire x =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | release x =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | produce =>
      obtain ⟨d, rfl⟩ := hls; flatten_rank hc
  | produceSym d =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | tapeProduce =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | waitCell =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | waitN i =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | chk =>
      obtain ⟨d, rfl⟩ := hls; flatten_rank hc
  | headCell =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | noHeadCell =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | heads =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | transition =>
      obtain ⟨q, q', c₁, c₂, m, -, rfl⟩ := hls; flatten_rank hc
  | transitionAndCheck =>
      simp only [bodies, Set.mem_insert_iff, Set.mem_singleton_iff] at hls
      rcases hls with rfl | rfl <;> flatten_rank hc
  | checkers i =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he
      · subst hls; simp at hc
      · subst h1
        simp only [Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hi : 2 ≤ i := by omega
        flatten_rank hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hi : 2 ≤ i := by omega
        flatten_rank hc
  | produceInit =>
      simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
  | produceWord i =>
      simp only [bodies] at hls
      split_ifs at hls with hi <;> simp only [Set.mem_singleton_iff] at hls <;> subst hls <;>
        flatten_rank hc
  | done =>
      obtain ⟨f, -, rfl⟩ := hls; simp at hc
  | cSeq t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he
      · subst hls; simp at hc
      · subst h1
        simp only [Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hk : 2 ≤ k := by omega
        flatten_rank hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hk : 2 ≤ k := by omega
        flatten_rank hc
  | cPar t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he
      · subst hls; simp at hc
      · subst h1
        simp only [Set.mem_singleton_iff] at hls; subst hls; flatten_rank hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hk : 2 ≤ k := by omega
        flatten_rank hc
      · simp only [Set.mem_singleton_iff] at hls; subst hls
        have hk : 2 ≤ k := by omega
        flatten_rank hc
  | sI => exact absurd hls (Set.notMem_empty _)

/-- Every compound task of the initial task network has a smaller rank than `sI`. -/
lemma rank_lt_of_mem_initNet {c : TMTask Q Γ} {p : ℕ × ℕ}
    (hp : p ∈ (initNet (Q := Q) (Γ := Γ) K).T)
    (hc : (initNet (Q := Q) (Γ := Γ) K).α p = Sum.inr c) :
    rank K w.length c < rank K w.length (TMTask.sI (Q := Q) (Γ := Γ)) := by
  have hmem := TaskNetwork.gridTail_α_mem_flatten (ls := initChains (Q := Q) (Γ := Γ) K)
    (tl := [Sum.inr TMTask.done]) hp
  rw [show (initNet (Q := Q) (Γ := Γ) K) =
    TaskNetwork.gridTail (initChains (Q := Q) (Γ := Γ) K) [Sum.inr TMTask.done] from rfl] at hc
  rw [hc] at hmem
  simp only [initChains, List.cons_append, List.nil_append] at hmem
  flatten_rank hmem

/-- **The encoded problem is acyclic** (Def. 3.6): the rank function `HTN.TMEnc.rank` strictly
decreases along every method.  Together with `HTN.TMEnc.isTO_tnI` this is the structural claim
of Theorem 4.3.7: the constructed problems lie in `TO-tn_I ∩ ACYC`. -/
theorem isAcyclic : (problem N w K).IsAcyclic := by
  refine Problem.isAcyclic_of_rank _ (rank K w.length) ?_
  rintro ⟨ct, tn⟩ ⟨hm, -⟩ t ht c hc
  rcases hm with ⟨ls, hls, hsub⟩ | hsI
  · subst hsub
    refine rank_lt_of_mem_bodies hls ?_
    have hmem := TaskNetwork.grid_α_mem_flatten (ls := ls) ht
    rwa [hc] at hmem
  · simp only [Set.mem_singleton_iff, Method.mk.injEq] at hsI
    obtain ⟨rfl, rfl⟩ := hsI
    exact rank_lt_of_mem_initNet (w := w) ht hc

end Acyclic

/-! ### The size of the translation

The translation is *not* claimed to be computable in polynomial time here (see the module
doc-string); what is proved is that the constructed domain consists of small methods and that
the counting gadget needs only logarithmically many task names — so nothing of exponential
size is ever written down. -/

section Size

variable {N : NTM Q Γ} {w : List Γ} {K : ℕ}

/-- Every method body consists of at most two parallel chains of at most five tasks each. -/
lemma bodies_small {t : TMTask Q Γ} {ls : List (List (TMAct Q Γ ⊕ TMTask Q Γ))}
    (hls : ls ∈ bodies N w K t) : ls.length ≤ 2 ∧ ∀ l ∈ ls, l.length ≤ 5 := by
  cases t with
  | acquire x => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | release x => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | produce => obtain ⟨d, rfl⟩ := hls; simp
  | produceSym d => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | tapeProduce => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | waitCell => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | waitN i => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | chk => obtain ⟨d, rfl⟩ := hls; simp
  | headCell => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | noHeadCell => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | heads => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | transition =>
      obtain ⟨q, q', c₁, c₂, mv, -, rfl⟩ := hls
      refine ⟨by simp, ?_⟩
      intro l hl
      simp only [List.mem_singleton] at hl
      subst hl
      cases mv <;> simp [moveExtra]
  | transitionAndCheck =>
      simp only [bodies, Set.mem_insert_iff, Set.mem_singleton_iff] at hls
      rcases hls with rfl | rfl <;> simp
  | checkers i =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he <;> simp only [Set.mem_singleton_iff] at hls <;>
        subst hls <;> simp
  | produceInit => simp only [bodies, Set.mem_singleton_iff] at hls; subst hls; simp
  | produceWord i =>
      simp only [bodies] at hls
      split_ifs at hls with hi <;> simp only [Set.mem_singleton_iff] at hls <;> subst hls <;>
        simp
  | done => obtain ⟨f, -, rfl⟩ := hls; simp
  | cSeq t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he <;> simp only [Set.mem_singleton_iff] at hls <;>
        subst hls <;> simp
  | cPar t k =>
      simp only [bodies] at hls
      split_ifs at hls with h0 h1 he <;> simp only [Set.mem_singleton_iff] at hls <;>
        subst hls <;> simp
  | sI => exact absurd hls (Set.notMem_empty _)

/-- **Every method of the encoded domain has at most `20` subtasks** — in particular a bound
independent of the (exponential) time bound `K`. -/
theorem method_card_le {m : Method (ℕ × ℕ) (TMAct Q Γ) (TMTask Q Γ)} (hm : m ∈ methods N w K) :
    m.subtasks.T.card ≤ 20 := by
  obtain ⟨ct, tn⟩ := m
  rcases hm with ⟨ls, hls, rfl⟩ | hsI
  · obtain ⟨h1, h2⟩ := bodies_small hls
    calc (TaskNetwork.grid ls).T.card ≤ ls.length * 5 := TaskNetwork.grid_card_le h2
      _ ≤ 20 := by omega
  · simp only [Set.mem_singleton_iff, Method.mk.injEq] at hsI
    obtain ⟨rfl, rfl⟩ := hsI
    have h2 : ∀ l ∈ initChains (Q := Q) (Γ := Γ) K, l.length ≤ 5 := by
      intro l hl; simp only [initChains, List.mem_cons, List.not_mem_nil, or_false] at hl
      rcases hl with rfl | rfl | rfl <;> simp
    have := TaskNetwork.gridTail_card_le (ls := initChains (Q := Q) (Γ := Γ) K)
      (tl := [Sum.inr TMTask.done]) (m := 5) h2 (by simp)
    simpa [initNet, initChains] using this

/-- **Every method of the encoded domain has size at most `421`**, again independently of the
time bound `K`. -/
theorem method_size_le {m : Method (ℕ × ℕ) (TMAct Q Γ) (TMTask Q Γ)} (hm : m ∈ methods N w K) :
    m.size ≤ 421 := by
  have hc := method_card_le hm
  have h := m.subtasks.size_le
  have : m.subtasks.T.card * m.subtasks.T.card ≤ 20 * 20 := Nat.mul_le_mul hc hc
  simp only [Method.size]
  omega

/-- The counting task `C^k_t` refers only to `t` itself and to the counting tasks `C^j_t` with
`j` in the halving closure of `k`; by `HTN.card_halvingClosure_le` there are at most
`2 · log₂ k + 2` of those.  This is the reason why the exponentially many copies of a task can
be generated by polynomially many methods. -/
lemma bodies_cSeq_mem_halvingClosure {t c : TMTask Q Γ} {k : ℕ}
    {ls : List (List (TMAct Q Γ ⊕ TMTask Q Γ))} (hls : ls ∈ bodies N w K (.cSeq t k))
    (hc : Sum.inr c ∈ ls.flatten) : c = t ∨ ∃ j ∈ halvingClosure k, c = .cSeq t j := by
  simp only [bodies] at hls
  split_ifs at hls with h0 h1 he
  · subst hls; simp at hc
  · simp only [Set.mem_singleton_iff] at hls; subst hls
    simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
      List.not_mem_nil, or_false, Sum.inr.injEq] at hc
    exact Or.inl hc
  · simp only [Set.mem_singleton_iff] at hls; subst hls
    have hk : 2 ≤ k := by omega
    have hchild : halvingChild k = k / 2 := by simp [halvingChild, he]
    simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
      List.not_mem_nil, or_false, Sum.inr.injEq] at hc
    refine Or.inr ⟨k / 2, ?_, ?_⟩
    · exact hchild ▸ halvingChild_mem_halvingClosure hk
    · rcases hc with h | h <;> exact h
  · simp only [Set.mem_singleton_iff] at hls; subst hls
    have hk : 2 ≤ k := by omega
    have hchild : halvingChild k = k - 1 := by simp [halvingChild, he]
    simp only [List.flatten_cons, List.flatten_nil, List.append_nil, List.mem_cons,
      List.not_mem_nil, or_false, Sum.inr.injEq] at hc
    rcases hc with h | h
    · exact Or.inl h
    · exact Or.inr ⟨k - 1, hchild ▸ halvingChild_mem_halvingClosure hk, h⟩

end Size

end TMEnc

end HTN
