import Mathlib

/-!
# Ideals of `ℕ^ι` and downward-closed sets

For a finite type `ι` of coordinates, an **ω-vector** is a function `v : ι → ℕ∞`; its **ideal**
is the downward-closed set `HTN.Petri.idl v = {x : ι → ℕ | ∀ i, x i ≤ v i}`.

* `HTN.Petri.idl_subset_iff` — `idl u ⊆ idl v ↔ u ≤ v`;
* `HTN.Petri.le_of_idl_subset_biUnion` — **ideals are irreducible**: an ideal contained in a
  finite union of ideals is contained in one of them;
* `HTN.Petri.exists_finset_idl` — **every downward-closed subset of `ℕ^ι` is a finite union of
  ideals** (from Dickson's lemma: the complement is generated by its finitely many minimal
  elements).

These are the facts behind the inductive-invariant certificates for non-coverability
(`ComplexityTheory/Petri/Cover.lean`) and, later, behind the decomposition step of the
reachability procedure that replaces a component by a graph of ideals.
-/

namespace HTN

namespace Petri

variable {ι : Type*}

/-- The **ideal** of an ω-vector. -/
def idl (v : ι → ℕ∞) : Set (ι → ℕ) := {x | ∀ i, (x i : ℕ∞) ≤ v i}

theorem mem_idl {v : ι → ℕ∞} {x : ι → ℕ} : x ∈ idl v ↔ ∀ i, (x i : ℕ∞) ≤ v i := Iff.rfl

theorem idl_mono {u v : ι → ℕ∞} (h : u ≤ v) : idl u ⊆ idl v :=
  fun _ hx i => (hx i).trans (h i)

theorem idl_inf (u v : ι → ℕ∞) : idl (u ⊓ v) = idl u ∩ idl v := by
  ext x
  simp only [mem_idl, Set.mem_inter_iff, Pi.inf_apply, le_inf_iff]
  exact ⟨fun h => ⟨fun i => (h i).1, fun i => (h i).2⟩, fun h i => ⟨h.1 i, h.2 i⟩⟩

theorem idl_top : idl (⊤ : ι → ℕ∞) = Set.univ := by
  ext x; simp [mem_idl]

/-- The point of an ideal with every `ω` replaced by `N`. -/
noncomputable def capPt (v : ι → ℕ∞) (N : ℕ) : ι → ℕ := fun i =>
  if v i = ⊤ then N else (v i).toNat

theorem capPt_mem (v : ι → ℕ∞) (N : ℕ) : capPt v N ∈ idl v := by
  intro i
  unfold capPt
  by_cases h : v i = ⊤
  · rw [h]; exact le_top
  · rw [if_neg h]
    exact (ENat.coe_toNat h).le

theorem capPt_of_ne_top {v : ι → ℕ∞} {N : ℕ} {i : ι} (h : v i ≠ ⊤) :
    (capPt v N i : ℕ∞) = v i := by
  unfold capPt
  rw [if_neg h]
  exact ENat.coe_toNat h

theorem capPt_of_top {v : ι → ℕ∞} {N : ℕ} {i : ι} (h : v i = ⊤) : N ≤ capPt v N i := by
  unfold capPt
  rw [if_pos h]

/-- **Irreducibility of ideals.** -/
theorem le_of_idl_subset_biUnion {u : ι → ℕ∞} {D : Finset (ι → ℕ∞)} [Finite ι]
    (h : idl u ⊆ ⋃ w ∈ D, idl w) : ∃ w ∈ D, u ≤ w := by
  classical
  have := Fintype.ofFinite ι
  -- a bound above all finite coordinates of the members of `D`
  let N : ℕ := ∑ w ∈ D, ∑ i, (w i).toNat + 1
  have hN : ∀ w ∈ D, ∀ i, w i ≠ ⊤ → (w i).toNat < N := by
    intro w hw i _
    have h1 : (w i).toNat ≤ ∑ i, (w i).toNat :=
      Finset.single_le_sum (f := fun i => (w i).toNat) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ i)
    have h2 : ∑ i, (w i).toNat ≤ ∑ w ∈ D, ∑ i, (w i).toNat :=
      Finset.single_le_sum (f := fun w : ι → ℕ∞ => ∑ i, (w i).toNat)
        (fun _ _ => Nat.zero_le _) hw
    omega
  obtain ⟨w, hw, hx⟩ := Set.mem_iUnion₂.1 (h (capPt_mem u N))
  refine ⟨w, hw, fun i => ?_⟩
  by_cases hu : u i = ⊤
  · by_contra hlt
    have hwi : w i ≠ ⊤ := fun h' => hlt (by rw [h']; exact le_top)
    have h1 := hx i
    have h2 := capPt_of_top (N := N) hu
    have h3 := hN w hw i hwi
    rw [← ENat.coe_toNat hwi, Nat.cast_le] at h1
    omega
  · rw [← capPt_of_ne_top (N := N) hu]
    exact hx i

/-- **`idl u ⊆ idl v ↔ u ≤ v`.** -/
theorem idl_subset_iff [Finite ι] {u v : ι → ℕ∞} : idl u ⊆ idl v ↔ u ≤ v := by
  refine ⟨fun h => ?_, idl_mono⟩
  obtain ⟨w, hw, hle⟩ := le_of_idl_subset_biUnion (D := {v}) (by simpa using h)
  rw [Finset.mem_singleton] at hw
  rwa [hw] at hle

/-! ### Downward-closed sets are finite unions of ideals -/

section Fin

variable [DecidableEq ι]

/-- The ω-vector `ω` everywhere except `n` at `i`. -/
def topExcept (i : ι) (n : ℕ) : ι → ℕ∞ := Function.update ⊤ i (n : ℕ∞)

theorem mem_idl_topExcept {i : ι} {n : ℕ} {x : ι → ℕ} : x ∈ idl (topExcept i n) ↔ x i ≤ n := by
  constructor
  · intro h
    have := h i
    simpa [topExcept] using this
  · intro h j
    by_cases hj : j = i
    · subst hj; simpa [topExcept] using h
    · simp [topExcept, Function.update_of_ne hj]

variable [Fintype ι]

/-- The ideals covering the points not above `b`. -/
noncomputable def notAbove (b : ι → ℕ) : Finset (ι → ℕ∞) :=
  (Finset.univ.filter fun i => 1 ≤ b i).image fun i => topExcept i (b i - 1)

theorem mem_biUnion_notAbove {b x : ι → ℕ} :
    x ∈ (⋃ v ∈ notAbove b, idl v) ↔ ¬ b ≤ x := by
  simp only [notAbove, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and,
    Set.mem_iUnion, exists_prop]
  constructor
  · rintro ⟨v, ⟨i, hi, rfl⟩, hx⟩ hle
    have h1 := mem_idl_topExcept.1 hx
    have h2 : b i ≤ x i := hle i
    omega
  · intro h
    rw [Pi.le_def] at h
    push_neg at h
    obtain ⟨i, hi⟩ := h
    exact ⟨_, ⟨i, by omega, rfl⟩, mem_idl_topExcept.2 (by omega)⟩

/-- The ideals of the points above no element of `B`. -/
noncomputable def avoid : List (ι → ℕ) → Finset (ι → ℕ∞)
  | [] => {⊤}
  | b :: B => Finset.image₂ (· ⊓ ·) (notAbove b) (avoid B)

theorem mem_biUnion_avoid {x : ι → ℕ} :
    ∀ B : List (ι → ℕ), x ∈ (⋃ v ∈ avoid B, idl v) ↔ ∀ b ∈ B, ¬ b ≤ x
  | [] => by simp [avoid, idl_top]
  | b :: B => by
    rw [List.forall_mem_cons, ← mem_biUnion_avoid B, ← mem_biUnion_notAbove]
    simp only [avoid, Set.mem_iUnion, exists_prop, Finset.mem_image₂]
    constructor
    · rintro ⟨_, ⟨u, hu, v, hv, rfl⟩, hx⟩
      rw [idl_inf] at hx
      exact ⟨⟨u, hu, hx.1⟩, ⟨v, hv, hx.2⟩⟩
    · rintro ⟨⟨u, hu, hxu⟩, ⟨v, hv, hxv⟩⟩
      exact ⟨u ⊓ v, ⟨u, hu, v, hv, rfl⟩, by rw [idl_inf]; exact ⟨hxu, hxv⟩⟩

/-- **Every downward-closed subset of `ℕ^ι` is a finite union of ideals.** -/
theorem exists_finset_idl (S : Set (ι → ℕ)) (hS : ∀ x ∈ S, ∀ y ≤ x, y ∈ S) :
    ∃ D : Finset (ι → ℕ∞), S = ⋃ v ∈ D, idl v := by
  classical
  -- the minimal elements of the complement
  set M := {x | Minimal (· ∈ Sᶜ) x} with hM
  have hMfin : M.Finite := by
    refine WellQuasiOrderedLE.finite_of_isAntichain fun a ha b hb hab hle => ?_
    exact hab (le_antisymm hle (hb.2 ha.1 hle))
  have hbelow : ∀ x ∈ Sᶜ, ∃ b ∈ M, b ≤ x := by
    intro x hx
    obtain ⟨b, hb, hmin⟩ := (wellFounded_lt (α := ι → ℕ)).has_min {y | y ∈ Sᶜ ∧ y ≤ x}
      ⟨x, hx, le_rfl⟩
    refine ⟨b, ⟨hb.1, fun y hy hyb => ?_⟩, hb.2⟩
    by_contra hne
    exact hmin y ⟨hy, hyb.trans hb.2⟩ (lt_of_le_not_ge hyb hne)
  refine ⟨avoid hMfin.toFinset.toList, Set.ext fun x => ?_⟩
  rw [mem_biUnion_avoid]
  simp only [Finset.mem_toList, Set.Finite.mem_toFinset]
  constructor
  · intro hx b hb hbx
    exact hb.1 (hS x hx b hbx)
  · intro h
    by_contra hx
    obtain ⟨b, hb, hbx⟩ := hbelow x hx
    exact h b hb hbx

end Fin

end Petri

end HTN
